.event-list-head {
  display: block;
  margin-bottom: 18rpx;
}

.hub-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.hub-action-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  min-height: 156rpx;
  padding: 20rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 26rpx;
  color: #e8eefa;
  background: rgba(255, 255, 255, .055);
  text-align: center;
}

.hub-action-card.primary-card {
  border-color: rgba(228, 199, 122, .46);
  background: linear-gradient(135deg, rgba(228, 199, 122, .2), rgba(143, 176, 255, .13));
}

.hub-action-icon {
  font-size: 34rpx;
  line-height: 1;
}

.hub-action-title {
  color: #f6f8ff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hub-action-sub {
  color: #9aa9c4;
  font-size: 21rpx;
  line-height: 1.25;
}

.section-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .055);
}

.section-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  border-radius: 999rpx;
  color: #9aa9c4;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.section-tab.active {
  color: #081120;
  background: linear-gradient(135deg, #e4c77a, #8fb0ff);
}

.event-section-head {
  margin-bottom: 14rpx;
}

.small-title {
  font-size: 30rpx;
}

.mini-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-height: 48rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(143, 176, 255, .24);
  border-radius: 999rpx;
  color: #9bbcff;
  background: rgba(143, 176, 255, .08);
  font-size: 22rpx;
  font-weight: 800;
}

.event-card {
  margin-bottom: 18rpx;
}

.event-cover {
  width: 100%;
  height: 260rpx;
  margin-bottom: 18rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .08);
}

.card-title {
  margin: 18rpx 0 8rpx;
  color: #f6f8ff;
  font-size: 32rpx;
  font-weight: 800;
}

.signup-count {
  color: #e4c77a;
  font-size: 26rpx;
  font-weight: 800;
}

.body {
  margin-top: 12rpx;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tournament-row {
  margin-bottom: 16rpx;
}

.tournament-row-head {
  align-items: flex-start;
  gap: 18rpx;
}

.tournament-title {
  margin-top: 14rpx;
}

.tournament-count {
  flex: 0 0 auto;
  color: #e4c77a;
  font-size: 28rpx;
  font-weight: 900;
}

.tournament-actions,
.game-secondary-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.small-action,
.secondary-action {
  min-height: 64rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.empty-action {
  width: 260rpx;
  min-height: 68rpx;
  margin: 18rpx auto 0;
  border-radius: 22rpx;
  font-size: 24rpx;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  margin: 14rpx 0 20rpx;
  border: 1rpx solid rgba(143, 176, 255, .26);
  border-radius: 24rpx;
  color: #8fb0ff;
  background: rgba(143, 176, 255, .08);
  font-size: 24rpx;
  font-weight: 800;
}

.recent-game-head {
  margin-top: 28rpx;
}

.recent-game-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 106rpx;
  margin-bottom: 14rpx;
}

.recent-game-row > view:first-child {
  min-width: 0;
}

.recent-game-title {
  color: #f6f8ff;
  font-size: 28rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-game-score {
  flex: 0 0 auto;
  color: #e4c77a;
  font-size: 32rpx;
  font-weight: 900;
}
