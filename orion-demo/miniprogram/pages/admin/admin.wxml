<view class="page admin-page">
  <view class="card panel stack">
    <view>
      <view class="eyebrow">🛠 管理</view>
      <view class="title">猎户管理台</view>
      <view class="subtle">{{user ? user.displayName : '请先登录管理员账号'}}</view>
    </view>
    <view wx:if="{{isAdmin}}" class="permission-track">
      <text wx:for="{{permissionChips}}" wx:key="*this" class="pill">{{item}}</text>
    </view>
  </view>

  <view wx:if="{{!isAdmin && !loading}}" class="section card panel stack">
    <view class="card-title">暂无管理权限</view>
    <view class="subtle">小程序管理台只对 A/B 管理员、数据组或运营组开放。普通队员请使用个人面板。</view>
    <button class="btn btn-primary" bindtap="go" data-url="/pages/profile/profile">返回个人面板</button>
  </view>

  <view wx:if="{{isAdmin}}" class="stats-grid section">
    <view wx:for="{{stats}}" wx:key="label" class="stat-card card panel">
      <view class="stat-value">{{item.value}}</view>
      <view class="subtle">{{item.label}}</view>
    </view>
  </view>

  <view wx:if="{{isAdmin && canManageSiteSettings}}" class="section card panel stack system-panel">
    <view>
      <view class="eyebrow">🌌 星阵</view>
      <view class="card-title">星阵全站发布</view>
      <view class="subtle">复用网页球员页同一份 players-starfield 配置。这里负责移动端发布，不复制网页粒子编队台。</view>
    </view>
    <view class="starfield-status">{{starfieldUpdatedText}}</view>
    <picker mode="selector" range="{{starfieldPresetOptions}}" range-key="label" value="{{starfieldPresetIndex}}" bindchange="onStarfieldPresetChange">
      <view class="picker-like">预设 · {{starfieldPresetLabel}}</view>
    </picker>
    <view class="two-col">
      <picker mode="selector" range="{{starfieldFormationOptions}}" range-key="label" value="{{starfieldFormationIndex}}" bindchange="onStarfieldFormationChange">
        <view class="picker-like compact-picker">{{starfieldFormationLabel}}</view>
      </picker>
      <picker mode="selector" range="{{starfieldPathOptions}}" range-key="label" value="{{starfieldPathIndex}}" bindchange="onStarfieldPathChange">
        <view class="picker-like compact-picker">{{starfieldPathLabel}}</view>
      </picker>
    </view>
    <view class="two-col">
      <picker mode="selector" range="{{starfieldParticleModeOptions}}" range-key="label" value="{{starfieldParticleModeIndex}}" bindchange="onStarfieldParticleModeChange">
        <view class="picker-like compact-picker">{{starfieldParticleModeLabel}}</view>
      </picker>
      <input class="input" type="number" placeholder="年份" value="{{starfieldYear}}" bindinput="onStarfieldYearInput" />
    </view>
    <view class="starfield-grid">
      <view class="starfield-control">
        <view class="row between">
          <text class="subtle">年份节点</text>
          <text class="setting-value">{{starfieldYearLimit}}</text>
        </view>
        <slider min="24" max="160" step="1" value="{{starfieldYearLimit}}" data-field="starfieldYearLimit" bindchange="onStarfieldSliderChange" activeColor="#e4c77a" backgroundColor="rgba(255,255,255,.16)" block-size="20" />
      </view>
      <view class="starfield-control">
        <view class="row between">
          <text class="subtle">路径速度</text>
          <text class="setting-value">{{starfieldPathDuration}}</text>
        </view>
        <slider min="5.6" max="24" step="0.2" value="{{starfieldPathDuration}}" data-field="starfieldPathDuration" bindchange="onStarfieldSliderChange" activeColor="#e4c77a" backgroundColor="rgba(255,255,255,.16)" block-size="20" />
      </view>
      <view class="starfield-control">
        <view class="row between">
          <text class="subtle">呼吸节奏</text>
          <text class="setting-value">{{starfieldBreatheDuration}}</text>
        </view>
        <slider min="5.8" max="18" step="0.2" value="{{starfieldBreatheDuration}}" data-field="starfieldBreatheDuration" bindchange="onStarfieldSliderChange" activeColor="#e4c77a" backgroundColor="rgba(255,255,255,.16)" block-size="20" />
      </view>
      <view class="starfield-control">
        <view class="row between">
          <text class="subtle">摆动幅度</text>
          <text class="setting-value">{{starfieldSway}}</text>
        </view>
        <slider min="0.2" max="2.6" step="0.1" value="{{starfieldSway}}" data-field="starfieldSway" bindchange="onStarfieldSliderChange" activeColor="#e4c77a" backgroundColor="rgba(255,255,255,.16)" block-size="20" />
      </view>
      <view class="starfield-control">
        <view class="row between">
          <text class="subtle">星阵间距</text>
          <text class="setting-value">{{starfieldSpread}}</text>
        </view>
        <slider min="0.82" max="1.28" step="0.01" value="{{starfieldSpread}}" data-field="starfieldSpread" bindchange="onStarfieldSliderChange" activeColor="#e4c77a" backgroundColor="rgba(255,255,255,.16)" block-size="20" />
      </view>
      <view class="starfield-control">
        <view class="row between">
          <text class="subtle">随机种子</text>
          <text class="setting-value">{{starfieldRandomSeed}}</text>
        </view>
        <input class="input compact-input" type="number" placeholder="1-999999" value="{{starfieldRandomSeed}}" bindinput="onStarfieldRandomSeedInput" />
      </view>
    </view>
    <view class="request-actions">
      <button class="btn btn-ghost" loading="{{saving}}" bindtap="resetStarfieldDefaults">恢复默认</button>
      <button class="btn btn-primary" loading="{{saving}}" bindtap="publishStarfieldSettings">发布到全站</button>
    </view>
    <view class="subtle">发布会写入同一套 site_settings，并进入后台审计；网页球员页和 wallpaper 模式读取同一份配置。</view>
  </view>

  <view wx:if="{{isAdmin && canManageEvents}}" class="section card panel stack">
    <view>
      <view class="eyebrow">📋 接龙</view>
      <view class="card-title">队内接龙管理</view>
      <view class="subtle">批量清理误发或测试接龙。日常修改优先进入接龙详情编辑，删除会写后台审计。</view>
    </view>
    <view class="event-admin-tools">
      <input class="input compact-input" placeholder="搜索标题、分类、日期、地点" value="{{eventSearch}}" bindinput="onEventSearchInput" />
      <picker mode="selector" range="{{eventTagFilterOptions}}" range-key="label" value="{{eventTagFilterIndex}}" bindchange="onEventTagFilterChange">
        <view class="picker-like compact-picker">{{eventTagFilterLabel}}</view>
      </picker>
    </view>
    <view class="game-batch-toolbar">
      <text class="subtle">已选 {{selectedEventCount}} 条</text>
      <view class="game-batch-actions">
        <button class="link" bindtap="selectAllBatchEvents">全选当前</button>
        <button class="link" bindtap="clearBatchEvents">清空</button>
      </view>
    </view>
    <checkbox-group class="game-batch-list" bindchange="onEventBatchSelectionChange">
      <label wx:for="{{visibleBatchEvents}}" wx:key="id" class="game-batch-row">
        <checkbox value="{{item.id}}" checked="{{item.selected}}" />
        <view class="game-batch-meta">
          <view class="game-batch-title">{{item.title}}</view>
          <view class="subtle">{{item.tagLabel}}</view>
          <view class="subtle">{{item.meta}}</view>
        </view>
        <view class="event-row-actions">
          <button class="link tiny-link" catchtap="openBatchEvent" data-id="{{item.id}}">详情</button>
          <button class="link tiny-link" catchtap="editBatchEvent" data-id="{{item.id}}">编辑</button>
        </view>
      </label>
    </checkbox-group>
    <view wx:if="{{!visibleBatchEvents.length}}" class="empty compact-empty">暂无接龙</view>
    <button wx:if="{{eventsHasMore}}" class="link load-more-games inline-load-more" loading="{{loadingMoreEvents}}" bindtap="loadMoreAdminEvents">加载更多接龙</button>
    <view class="danger-zone batch-delete-zone">
      <view class="card-title danger-title">危险操作</view>
      <input class="input" placeholder="输入“删除接龙”确认" value="{{eventDeleteConfirmText}}" bindinput="onEventDeleteConfirmInput" />
      <button class="btn btn-danger" loading="{{saving}}" bindtap="batchDeleteEvents">删除选中接龙</button>
      <view class="subtle">删除后接龙详情和报名名单会移除；已经形成的签到、积分或比赛记录不会被批量改写。</view>
    </view>
  </view>

  <view wx:if="{{isAdmin && canWritePlayers}}" class="section card panel stack player-merge-panel">
    <view>
      <view class="eyebrow">👥 球员</view>
      <view class="card-title">球员档案管理</view>
      <view class="subtle">新增试训/正式球员，或处理重复档案和历史姓名归并。</view>
    </view>
    <view class="account-action-box player-pool-box">
      <view class="row between">
        <view>
          <view class="card-title compact-title">注册球员池</view>
          <view class="subtle">{{playerPoolSummary}}</view>
        </view>
      </view>
      <view class="player-pool-tools">
        <input class="input compact-input" placeholder="搜索姓名、别名、背号、守位" value="{{playerPoolSearch}}" bindinput="onPlayerPoolSearchInput" />
        <picker mode="selector" range="{{playerPoolLevelOptions}}" range-key="label" value="{{playerPoolLevelIndex}}" bindchange="onPlayerPoolLevelChange">
          <view class="picker-like compact-picker">{{playerPoolLevelLabel}}</view>
        </picker>
      </view>
      <scroll-view scroll-y class="player-pool-list">
        <view wx:for="{{visiblePlayerPool}}" wx:key="id" class="player-pool-row">
          <view class="player-pool-main">
            <view class="player-pool-title">
              <text class="player-pool-number">{{item.numberText}}</text>
              <text>{{item.name}}</text>
            </view>
            <view class="subtle">{{item.positionText}} · {{item.meta}}</view>
            <view class="player-pool-tags">
              <text class="player-level-tag {{item.levelClass}}">{{item.levelLabel}}</text>
            </view>
          </view>
          <view class="player-pool-actions">
            <button class="link tiny-link" data-id="{{item.id}}" bindtap="openPoolPlayer">档案</button>
            <button class="link tiny-link" data-id="{{item.id}}" bindtap="selectPoolPlayerRecords">积分</button>
            <button class="link tiny-link" data-id="{{item.id}}" bindtap="openPoolHighlights">时刻</button>
            <button class="link tiny-link" data-id="{{item.id}}" bindtap="selectPoolMergeSource">合并</button>
            <button wx:if="{{item.canUpgrade}}" class="link tiny-link primary-link" data-id="{{item.id}}" bindtap="upgradePoolPlayer">升级</button>
            <button wx:if="{{canManageBindCodes && item.canCreateBindCode}}" class="link tiny-link" data-id="{{item.id}}" bindtap="createPoolBindCode">绑码</button>
          </view>
        </view>
        <view wx:if="{{!visiblePlayerPool.length}}" class="empty compact-empty">暂无匹配球员</view>
      </scroll-view>
      <button wx:if="{{playersHasMore}}" class="link load-more-games inline-load-more" loading="{{loadingMorePlayers}}" bindtap="loadMoreAdminPlayers">加载更多球员</button>
    </view>
    <view class="account-action-box player-create-box">
      <view class="card-title compact-title">新增球员</view>
      <view class="two-col">
        <picker mode="selector" range="{{playerCreateLevelOptions}}" range-key="label" value="{{createPlayerLevelIndex}}" bindchange="onCreatePlayerLevelChange">
          <view class="picker-like compact-picker">{{createPlayerLevelLabel}}</view>
        </picker>
        <input class="input" placeholder="姓名" value="{{createPlayerName}}" bindinput="onCreatePlayerNameInput" />
      </view>
      <view class="two-col">
        <input class="input" placeholder="背号" value="{{createPlayerNumber}}" bindinput="onCreatePlayerNumberInput" />
        <input class="input" placeholder="守位，例如 CF / P" value="{{createPlayerPosition}}" bindinput="onCreatePlayerPositionInput" />
      </view>
      <view class="two-col">
        <input class="input" placeholder="打席 R / L / S" value="{{createPlayerBats}}" bindinput="onCreatePlayerBatsInput" />
        <input class="input" placeholder="投球 R / L" value="{{createPlayerThrows}}" bindinput="onCreatePlayerThrowsInput" />
      </view>
      <input class="input" type="number" placeholder="入队年份，可选" value="{{createPlayerJoinYear}}" bindinput="onCreatePlayerJoinYearInput" />
      <textarea class="textarea compact" maxlength="24" placeholder="口号，可选" value="{{createPlayerSlogan}}" bindinput="onCreatePlayerSloganInput" />
      <textarea class="textarea compact" placeholder="荣誉标签，用顿号或逗号分隔" value="{{createPlayerTitles}}" bindinput="onCreatePlayerTitlesInput" />
      <textarea class="textarea compact" placeholder="别名，用顿号或逗号分隔，用于历史比赛匹配" value="{{createPlayerAliases}}" bindinput="onCreatePlayerAliasesInput" />
      <view class="create-player-photo-box">
        <view class="create-player-photo-head">
          <text>📸 真实球员照片</text>
          <text class="subtle mini-subtle">上传后自动写入档案</text>
        </view>
        <image wx:if="{{createPlayerPhoto}}" class="create-player-photo-preview" src="{{createPlayerPhoto}}" mode="aspectFill" lazy-load="true" />
        <input class="input" placeholder="图片 URL，可粘贴或上传" value="{{createPlayerPhoto}}" bindinput="onCreatePlayerPhotoInput" />
        <view class="create-photo-actions">
          <button class="btn btn-ghost small-btn" loading="{{uploadingCreatePlayerPhoto}}" bindtap="chooseCreatePlayerPhoto">上传照片</button>
          <button class="btn btn-ghost small-btn" bindtap="clearCreatePlayerPhoto">清空照片</button>
        </view>
        <view wx:if="{{createPlayerPhotoUploadText}}" class="subtle">{{createPlayerPhotoUploadText}}</view>
      </view>
      <view wx:if="{{createPlayerResultText}}" class="invite-code">{{createPlayerResultText}}</view>
      <button class="btn btn-primary" loading="{{saving}}" bindtap="createPlayer">新增球员</button>
    </view>
    <view class="account-action-box player-batch-box">
      <view class="card-title compact-title">批量粘贴导入</view>
      <view class="subtle">每行一个球员：姓名,球衣号,守位；也可继续补打席、投球、入队年份、别名。</view>
      <picker mode="selector" range="{{playerCreateLevelOptions}}" range-key="label" value="{{batchPlayerLevelIndex}}" bindchange="onBatchPlayerLevelChange">
        <view class="picker-like compact-picker">{{batchPlayerLevelLabel}}</view>
      </picker>
      <textarea class="textarea batch-player-text" placeholder="例如：&#10;张三,15,2B&#10;李四,22,OF,R,R,2026,小李、Li" value="{{batchPlayerText}}" bindinput="onBatchPlayerTextInput" />
      <view class="batch-photo-box">
        <view class="batch-photo-head">
          <text>🖼 批量照片匹配</text>
          <text class="subtle mini-subtle">{{batchPlayerPhotoCount}} 张</text>
        </view>
        <view class="subtle">照片文件名写球员姓名，例如“张三.jpg”，导入时会自动匹配到同名球员档案。</view>
        <view class="create-photo-actions">
          <button class="btn btn-ghost small-btn" loading="{{uploadingBatchPlayerPhotos}}" bindtap="chooseBatchPlayerPhotos">选择照片</button>
          <button class="btn btn-ghost small-btn" bindtap="clearBatchPlayerPhotos">清空照片</button>
        </view>
        <view wx:if="{{batchPlayerPhotoText}}" class="subtle">{{batchPlayerPhotoText}}</view>
      </view>
      <view wx:if="{{batchPlayerResultText}}" class="invite-code">{{batchPlayerResultText}}</view>
      <button class="btn btn-ghost" loading="{{saving}}" bindtap="importPlayersBatch">导入名单</button>
    </view>
    <view class="divider"></view>
    <view>
      <view class="card-title compact-title">合并球员档案</view>
      <view class="subtle">用于试训转正式、重复档案或 PDF/比赛记录姓名归并。</view>
    </view>
    <picker mode="selector" range="{{mergeSourceOptions}}" range-key="label" value="{{mergeSourceIndex}}" bindchange="onMergeSourceChange">
      <view class="picker-like">{{mergeSourceLabel}}</view>
    </picker>
    <picker mode="selector" range="{{mergeTargetOptions}}" range-key="label" value="{{mergeTargetIndex}}" bindchange="onMergeTargetChange">
      <view class="picker-like">{{mergeTargetLabel}}</view>
    </picker>
    <checkbox-group class="merge-options" bindchange="onMergeKeepAliasChange">
      <label class="admin-group-option merge-option">
        <checkbox value="keep" checked="{{mergeKeepAliasValues.length > 0}}" />
        <text>保留源姓名和别名用于历史统计归并</text>
      </label>
    </checkbox-group>
    <view class="merge-preview">{{mergePreviewText}}</view>
    <view wx:if="{{mergeResultText}}" class="invite-code">{{mergeResultText}}</view>
    <button class="btn btn-primary" loading="{{saving}}" bindtap="mergePlayers">确认合并</button>
  </view>

  <view wx:if="{{isAdmin && (canManageTournaments || canMoveGames)}}" class="section card panel stack">
    <view>
      <view class="eyebrow">🏆 赛事</view>
      <view class="card-title">赛事设置</view>
      <view class="subtle">创建/编辑赛事容器，或把历史比赛批量移动到目标赛事。</view>
    </view>
    <block wx:if="{{canManageTournaments}}">
      <picker mode="selector" range="{{tournamentOptions}}" range-key="label" value="{{tournamentIndex}}" bindchange="onTournamentChange">
        <view class="picker-like">{{tournamentLabel}}</view>
      </picker>
      <button wx:if="{{tournamentHasMore}}" class="btn btn-ghost small-btn" loading="{{loadingMoreTournaments}}" bindtap="loadMoreAdminTournaments">加载更多赛事</button>
      <view class="two-col">
        <picker mode="selector" range="{{tournamentTypeOptions}}" range-key="label" value="{{tournamentTypeIndex}}" bindchange="onTournamentTypeChange">
          <view class="picker-like compact-picker">{{tournamentTypeLabel}}</view>
        </picker>
        <picker mode="selector" range="{{tournamentSportOptions}}" range-key="label" value="{{tournamentSportIndex}}" bindchange="onTournamentSportChange">
          <view class="picker-like compact-picker">{{tournamentSportLabel}}</view>
        </picker>
      </view>
      <input class="input" placeholder="赛事全称，例如 奥体慢垒春季赛" value="{{tournamentName}}" bindinput="onTournamentNameInput" />
      <view class="two-col">
        <input class="input" placeholder="短名" value="{{tournamentShortName}}" bindinput="onTournamentShortNameInput" />
        <input class="input" placeholder="赛季，例如 2026-slow" value="{{tournamentSeason}}" bindinput="onTournamentSeasonInput" />
      </view>
      <input class="input" placeholder="地点" value="{{tournamentLocation}}" bindinput="onTournamentLocationInput" />
      <view class="two-col">
        <picker mode="date" value="{{tournamentStartDate}}" bindchange="onTournamentStartDateChange">
          <view class="picker-like compact-picker">{{tournamentStartDate || '开始日期'}}</view>
        </picker>
        <picker mode="date" value="{{tournamentEndDate}}" bindchange="onTournamentEndDateChange">
          <view class="picker-like compact-picker">{{tournamentEndDate || '结束日期'}}</view>
        </picker>
      </view>
      <view class="tournament-cover-box">
        <view class="tournament-cover-head">
          <text>赛事封面</text>
          <text wx:if="{{tournamentCoverUploadText}}" class="subtle mini-subtle">{{tournamentCoverUploadText}}</text>
        </view>
        <image wx:if="{{tournamentCover}}" class="tournament-cover-preview" src="{{tournamentCover}}" mode="aspectFill" lazy-load="{{true}}" />
        <input class="input" placeholder="COS 图片地址，可手动粘贴" value="{{tournamentCover}}" bindinput="onTournamentCoverInput" />
        <view class="tournament-cover-actions">
          <button class="btn btn-ghost small-btn" loading="{{uploadingTournamentCover}}" bindtap="chooseTournamentCover">{{tournamentCover ? '更换封面' : '上传封面'}}</button>
          <button class="btn btn-ghost small-btn" bindtap="clearTournamentCover">清空封面</button>
        </view>
      </view>
      <textarea class="textarea compact" placeholder="赛事说明，可选" value="{{tournamentDescription}}" bindinput="onTournamentDescriptionInput" />
      <button class="btn btn-primary" loading="{{saving}}" bindtap="saveTournament">保存赛事</button>
      <view wx:if="{{canDeleteTournaments && tournamentIndex > 0}}" class="account-action-box danger-zone">
        <view class="card-title danger-title">危险操作</view>
        <input class="input" placeholder="输入“删除赛事”确认" value="{{tournamentDeleteConfirmText}}" bindinput="onTournamentDeleteConfirmInput" />
        <button class="btn btn-danger" loading="{{saving}}" bindtap="deleteTournament">删除赛事</button>
        <view class="subtle">删除赛事容器不会删除比赛记录；需要归档时可用下方批量移动比赛。</view>
      </view>
    </block>
    <view wx:if="{{canMoveGames}}" class="account-action-box game-batch-box">
      <view>
        <view class="card-title compact-title">批量移动比赛</view>
        <view class="subtle">用于把导入或旧赛季比赛归档到正确赛事；只改赛事归属和赛季字段，不改比分和技术统计。</view>
      </view>
      <picker mode="selector" range="{{gameMoveTournamentOptions}}" range-key="label" value="{{gameMoveTournamentIndex}}" bindchange="onGameMoveTournamentChange">
        <view class="picker-like">{{gameMoveTournamentLabel}}</view>
      </picker>
      <picker mode="selector" range="{{gameFilterOptions}}" range-key="label" value="{{gameFilterIndex}}" bindchange="onGameFilterChange">
        <view class="picker-like compact-picker">{{gameFilterLabel}}</view>
      </picker>
      <view class="game-batch-toolbar">
        <text class="subtle">已选 {{selectedGameCount}} 场</text>
        <view class="game-batch-actions">
          <button class="link" bindtap="selectAllBatchGames">全选当前</button>
          <button class="link" bindtap="clearBatchGames">清空</button>
        </view>
      </view>
      <checkbox-group class="game-batch-list" bindchange="onGameBatchSelectionChange">
        <label wx:for="{{visibleBatchGames}}" wx:key="id" class="game-batch-row">
          <checkbox value="{{item.id}}" checked="{{item.selected}}" />
          <view class="game-batch-meta">
            <view class="game-batch-title">{{item.title}}</view>
            <view class="subtle">{{item.tournamentLabel}}</view>
            <view class="subtle">{{item.meta}}</view>
          </view>
        </label>
      </checkbox-group>
      <view wx:if="{{!visibleBatchGames.length}}" class="empty compact-empty">暂无可移动比赛</view>
      <button wx:if="{{gamesHasMore}}" class="link load-more-games" loading="{{loadingMoreGames}}" bindtap="loadMoreAdminGames">加载更多比赛</button>
      <button class="btn btn-primary" loading="{{saving}}" bindtap="batchReassignGames">移动选中比赛</button>
      <view wx:if="{{canDeleteGames}}" class="danger-zone batch-delete-zone">
        <view class="card-title danger-title">危险操作</view>
        <input class="input" placeholder="输入“删除比赛”确认" value="{{gameDeleteConfirmText}}" bindinput="onGameDeleteConfirmInput" />
        <button class="btn btn-danger" loading="{{saving}}" bindtap="batchDeleteGames">删除选中比赛</button>
        <view class="subtle">删除会移除选中比赛的比分、技术统计和事件日志；数据录入错误优先使用比赛详情里的修订。</view>
      </view>
    </view>
  </view>

  <view wx:if="{{isAdmin && (canManageUsers || canCreateAppConnectCode || canResetPassword || canBindDirect || canDeleteUsers)}}" class="section card panel stack">
    <view>
      <view class="eyebrow">👤 权限</view>
      <view class="card-title">账号管理</view>
      <view class="subtle">A 级可调整后台等级、生成网页关联码、重置网页密码，并直接处理账号与正式球员档案的绑定关系。</view>
    </view>
    <view class="admin-user-filters">
      <input class="input admin-user-search" placeholder="搜索昵称、邮箱、球员、号码" value="{{adminUserSearch}}" bindinput="onAdminUserSearchInput" />
      <picker mode="selector" range="{{adminIdentityFilterOptions}}" range-key="label" value="{{adminIdentityFilterIndex}}" bindchange="onAdminIdentityFilterChange">
        <view class="picker-like compact-picker">{{adminIdentityFilterLabel}}</view>
      </picker>
      <picker mode="selector" range="{{adminGroupFilterOptions}}" range-key="label" value="{{adminGroupFilterIndex}}" bindchange="onAdminGroupFilterChange">
        <view class="picker-like compact-picker">{{adminGroupFilterLabel}}</view>
      </picker>
      <picker class="admin-position-filter" mode="selector" range="{{adminPositionFilterOptions}}" range-key="label" value="{{adminPositionFilterIndex}}" bindchange="onAdminPositionFilterChange">
        <view class="picker-like compact-picker">{{adminPositionFilterLabel}}</view>
      </picker>
      <picker class="admin-bind-filter" mode="selector" range="{{adminBindFilterOptions}}" range-key="label" value="{{adminBindFilterIndex}}" bindchange="onAdminBindFilterChange">
        <view class="picker-like compact-picker">{{adminBindFilterLabel}}</view>
      </picker>
      <picker class="admin-sort-filter" mode="selector" range="{{adminUserSortOptions}}" range-key="label" value="{{adminUserSortIndex}}" bindchange="onAdminUserSortChange">
        <view class="picker-like compact-picker">{{adminUserSortLabel}}</view>
      </picker>
    </view>
    <view class="subtle">筛选结果：{{adminUserFilterSummary}}</view>
    <button wx:if="{{adminUsersHasMore}}" class="btn btn-ghost small-btn" loading="{{loadingMoreAdminUsers}}" bindtap="loadMoreAdminUsers">加载更多账号</button>
    <picker mode="selector" range="{{adminUserOptions}}" range-key="label" value="{{adminUserIndex}}" bindchange="onAdminUserChange">
      <view class="picker-like">{{adminUserLabel}}</view>
    </picker>
    <view wx:if="{{adminUserMeta}}" class="subtle">{{adminUserMeta}}</view>
    <view wx:if="{{canManageUsers}}" class="stack">
      <picker mode="selector" range="{{adminLevelOptions}}" range-key="label" value="{{adminLevelIndex}}" bindchange="onAdminLevelChange">
        <view class="picker-like">{{adminLevelLabel}}</view>
      </picker>
      <checkbox-group class="admin-group-list" bindchange="onAdminGroupChange">
        <label wx:for="{{adminGroupOptions}}" wx:key="value" class="admin-group-option">
          <checkbox value="{{item.value}}" checked="{{item.checked}}" />
          <text>{{item.label}}</text>
        </label>
      </checkbox-group>
      <button class="btn btn-primary" loading="{{saving}}" bindtap="saveAdminPermission">保存权限</button>
    </view>
    <view wx:if="{{canCreateAppConnectCode}}" class="account-action-box">
      <button class="btn btn-ghost" loading="{{saving}}" bindtap="createAdminAppConnectCode">生成网页关联码</button>
      <view wx:if="{{appConnectCode}}" class="invite-code">网页关联码：{{appConnectCode}}</view>
      <view class="subtle">关联码 30 分钟内有效，生成后会自动复制。</view>
    </view>
    <view wx:if="{{canResetPassword}}" class="account-action-box">
      <input class="input" password="{{true}}" placeholder="新网页密码，至少 6 位" value="{{resetPasswordValue}}" bindinput="onResetPasswordInput" />
      <button class="btn btn-ghost" loading="{{saving}}" bindtap="resetAdminPassword">重置网页密码</button>
      <view class="subtle">只影响邮箱网页登录；不能在这里重置当前登录账号自己的密码。</view>
    </view>
    <view wx:if="{{canBindDirect}}" class="account-action-box">
      <picker mode="selector" range="{{directBindPlayerOptions}}" range-key="label" value="{{directBindPlayerIndex}}" bindchange="onDirectBindPlayerChange">
        <view class="picker-like">{{directBindPlayerLabel}}</view>
      </picker>
      <view class="request-actions">
        <button class="btn btn-primary small-btn" loading="{{saving}}" bindtap="bindAdminUserToPlayer">直接绑定</button>
        <button class="btn btn-danger small-btn" loading="{{saving}}" bindtap="unbindAdminUserFromPlayer">解除绑定</button>
      </view>
      <view class="subtle">用于管理员线下确认身份后的修正；常规用户仍优先走绑定申请审批。</view>
    </view>
    <view wx:if="{{canDeleteUsers}}" class="account-action-box danger-zone">
      <view class="card-title danger-title">危险操作</view>
      <input class="input" placeholder="输入“删除账号”确认" value="{{deleteConfirmText}}" bindinput="onDeleteConfirmInput" />
      <button class="btn btn-danger" loading="{{saving}}" bindtap="deleteAdminUser">删除账号</button>
      <view class="subtle">删除账号不会删除正式球员档案；所有者账号和当前登录账号不能删除。</view>
    </view>
  </view>

  <view wx:if="{{isAdmin}}" class="section card panel stack">
    <view class="row between">
      <view>
        <view class="eyebrow">✅ 审批</view>
        <view class="card-title">绑定审批</view>
      </view>
      <button class="link" bindtap="load">刷新</button>
    </view>
    <picker mode="selector" range="{{bindRequestStatusOptions}}" range-key="label" value="{{bindRequestStatusIndex}}" bindchange="onBindRequestStatusChange">
      <view class="picker-like compact-picker">{{bindRequestStatusLabel}}</view>
    </picker>
    <textarea class="textarea compact" placeholder="审批备注，可选" value="{{reviewNote}}" bindinput="onReviewNoteInput" />
    <view wx:for="{{pendingRequests}}" wx:key="id" class="request-card">
      <view>
        <view class="request-title-row">
          <view class="request-title">{{item.applicant}}</view>
          <view class="request-status {{item.statusClass}}">{{item.statusLabel}}</view>
        </view>
        <view class="subtle">申请绑定：{{item.target}}</view>
        <view wx:if="{{item.meta}}" class="subtle">{{item.meta}}</view>
        <view wx:if="{{item.note}}" class="note">{{item.note}}</view>
      </view>
      <view wx:if="{{item.isPending}}" class="request-actions">
        <button class="btn btn-primary small-btn" loading="{{saving}}" bindtap="approveRequest" data-id="{{item.id}}">批准</button>
        <button class="btn btn-danger small-btn" loading="{{saving}}" bindtap="rejectRequest" data-id="{{item.id}}">驳回</button>
      </view>
    </view>
    <view wx:if="{{!pendingRequests.length}}" class="empty">{{bindRequestEmptyText}}</view>
  </view>

  <view wx:if="{{isAdmin && canBindInvite}}" class="section card panel stack">
    <view>
      <view class="eyebrow">🔗 绑定</view>
      <view class="card-title">发送绑定邀请</view>
      <view class="subtle">给已注册账号发送站内信邀请，附带正式球员绑定码。</view>
    </view>
    <picker mode="selector" range="{{inviteUserOptions}}" range-key="label" value="{{inviteUserIndex}}" bindchange="onInviteUserChange">
      <view class="picker-like">{{inviteUserLabel}}</view>
    </picker>
    <button wx:if="{{inviteUsersHasMore}}" class="btn btn-ghost load-more" loading="{{loadingMoreInviteUsers}}" bindtap="loadMoreInviteUsers">加载更多可邀请用户</button>
    <picker mode="selector" range="{{invitePlayerOptions}}" range-key="label" value="{{invitePlayerIndex}}" bindchange="onInvitePlayerChange">
      <view class="picker-like">{{invitePlayerLabel}}</view>
    </picker>
    <textarea class="textarea compact" placeholder="站内信备注，可选" value="{{inviteMessage}}" bindinput="onInviteMessageInput" />
    <button class="btn btn-primary" loading="{{saving}}" bindtap="sendBindInvitation">发送绑定邀请</button>
    <view wx:if="{{inviteCode}}" class="invite-code">绑定码：{{inviteCode}}</view>
  </view>

  <view wx:if="{{isAdmin && canManageBindCodes}}" class="section card panel stack">
    <view>
      <view class="eyebrow">🔐 绑定码</view>
      <view class="card-title">绑定码中心</view>
      <view class="subtle">备用绑定路径：生成正式球员绑定码、复制给队员，或作废不再使用的码。</view>
    </view>
    <picker mode="selector" range="{{bindCodePlayerOptions}}" range-key="label" value="{{bindCodePlayerIndex}}" bindchange="onBindCodePlayerChange">
      <view class="picker-like">{{bindCodePlayerLabel}}</view>
    </picker>
    <button class="btn btn-primary" loading="{{saving}}" bindtap="createBindCode">生成绑定码</button>
    <view wx:if="{{generatedBindCode}}" class="invite-code">新绑定码：{{generatedBindCode}}</view>
    <input class="input" placeholder="搜索绑定码、球员名、背号或状态" value="{{bindCodeSearch}}" bindinput="onBindCodeSearchInput" />
    <view class="bind-code-list">
      <view wx:for="{{visibleBindCodes}}" wx:key="code" class="bind-code-row">
        <view class="bind-code-main">
          <view class="bind-code-value">{{item.code}}</view>
          <view class="subtle">{{item.playerText}}</view>
          <view wx:if="{{item.meta}}" class="subtle">{{item.meta}}</view>
        </view>
        <view class="bind-code-side">
          <view class="bind-code-status {{item.statusClass}}">{{item.statusLabel}}</view>
          <view class="bind-code-actions">
            <button class="link tiny-link" data-code="{{item.code}}" bindtap="copyBindCode">复制</button>
            <button class="link tiny-link danger-link" data-code="{{item.code}}" bindtap="deleteBindCode">作废</button>
          </view>
        </view>
      </view>
    </view>
    <button wx:if="{{bindCodesHasMore}}" class="btn btn-ghost load-more" loading="{{loadingMoreBindCodes}}" bindtap="loadMoreBindCodes">加载更多绑定码</button>
    <view wx:if="{{!visibleBindCodes.length}}" class="empty compact-empty">暂无匹配绑定码</view>
  </view>

  <view wx:if="{{isAdmin && (canWritePoints || canWriteAttendances)}}" class="section card panel stack points-panel">
    <view>
      <view class="eyebrow">🧾 操作</view>
      <view class="card-title">积分与签到</view>
      <view class="subtle">查看全员积分总览，补录后可查看选中球员的近期记录；录错时从这里撤销，后端会写审计。</view>
    </view>
    <view wx:if="{{canViewPointsOverview}}" class="account-action-box points-overview-box">
      <view class="row between">
        <view class="card-title compact-title">全员积分总览</view>
        <button class="link" bindtap="go" data-url="/pages/points/points">详情</button>
      </view>
      <view wx:for="{{leaderboardOverview}}" wx:key="playerId" class="leaderboard-overview-row {{item.rankClass}}" bindtap="openLeaderboardPlayer" data-id="{{item.playerId}}">
        <view class="overview-rank">{{item.rank}}</view>
        <view class="overview-main">
          <view class="overview-name">{{item.displayName}}</view>
          <view class="subtle">{{item.meta}}</view>
          <view class="subtle">{{item.breakdownText}}</view>
        </view>
        <view class="overview-total">{{item.total}}</view>
      </view>
      <view wx:if="{{!leaderboardOverview.length}}" class="empty compact-empty">暂无积分记录</view>
    </view>
    <picker mode="selector" range="{{playerOptions}}" range-key="label" value="{{playerIndex}}" bindchange="onPlayerChange">
      <view class="picker-like">{{playerLabel}}</view>
    </picker>
    <button wx:if="{{playersHasMore}}" class="link load-more-games inline-load-more" loading="{{loadingMorePlayers}}" bindtap="loadMoreAdminPlayers">加载更多球员候选</button>
    <view wx:if="{{canWritePoints}}" class="account-action-box score-action-box">
      <view class="card-title compact-title">手动积分调整</view>
      <view class="two-col">
        <input class="input" type="number" placeholder="积分，例如 5 或 -3" value="{{pointDelta}}" bindinput="onPointDeltaInput" />
        <input class="input" placeholder="原因" value="{{pointReason}}" bindinput="onPointReasonInput" />
      </view>
      <view class="point-game-selector">
        <view class="row between">
          <view>
            <view class="subtle">关联比赛（可选）</view>
            <view class="point-game-label">{{pointGameLabel}}</view>
            <view class="subtle">{{pointGameMeta}}</view>
          </view>
          <button class="link" bindtap="clearPointGame">清除</button>
        </view>
        <view class="point-game-tools">
          <input class="input compact-input" placeholder="搜索对手、日期、赛事、场地" value="{{pointGameSearch}}" bindinput="onPointGameSearchInput" />
          <picker mode="selector" range="{{pointGameOptions}}" range-key="label" value="{{pointGameIndex}}" bindchange="onPointGameChange">
            <view class="picker-like compact-picker">选择比赛</view>
          </picker>
        </view>
        <button wx:if="{{gamesHasMore}}" class="link load-more-games inline-load-more" loading="{{loadingMoreGames}}" bindtap="loadMoreAdminGames">加载更多比赛候选</button>
      </view>
      <button class="btn btn-ghost" loading="{{saving}}" bindtap="submitPointAdjustment">手动调整积分</button>
      <view class="history-list">
        <view wx:for="{{pointAdjustments}}" wx:key="id" class="history-row">
          <view class="history-main">
            <view class="history-title"><text class="score-delta {{item.deltaClass}}">{{item.deltaText}}</text><text>{{item.reasonText}}</text></view>
            <view class="subtle">{{item.meta}}</view>
          </view>
          <button class="link tiny-link danger-link" data-id="{{item.id}}" bindtap="deletePointAdjustment">删除</button>
        </view>
        <view wx:if="{{!pointAdjustments.length}}" class="empty compact-empty">暂无手动积分记录</view>
      </view>
    </view>

	    <view wx:if="{{canWriteAttendances}}" class="account-action-box score-action-box">
	      <view class="card-title compact-title">补录签到</view>
	      <picker mode="selector" range="{{attendanceKinds}}" range-key="label" value="{{attendanceKindIndex}}" bindchange="onAttendanceKindChange">
	        <view class="picker-like">{{attendanceKindLabel}}</view>
      </picker>
	      <picker mode="date" value="{{attendanceDate}}" bindchange="onAttendanceDateChange">
	        <view class="picker-like">{{attendanceDate}}</view>
	      </picker>
	      <input class="input" placeholder="备注，例如补录训练 / 比赛到场" value="{{attendanceNote}}" bindinput="onAttendanceNoteInput" />
	      <view class="attendance-batch-box">
	        <view class="row between">
	          <view>
	            <view class="card-title compact-title">批量出席名单</view>
	            <view class="subtle">{{attendanceSelectionSummary}}</view>
	          </view>
	          <button class="link" bindtap="clearAttendancePlayers">清空</button>
	        </view>
	        <view class="attendance-batch-tools">
	          <input class="input compact-input" placeholder="搜索球员、背号、守位" value="{{attendancePlayerSearch}}" bindinput="onAttendancePlayerSearchInput" />
	          <button class="link" bindtap="selectAllAttendancePlayers">全选当前</button>
	        </view>
	        <checkbox-group class="attendance-player-list" bindchange="onAttendancePlayerSelectionChange">
	          <label wx:for="{{visibleAttendancePlayers}}" wx:key="id" class="attendance-player-row">
	            <checkbox value="{{item.id}}" checked="{{item.selected}}" />
	            <view class="attendance-player-main">
	              <view class="attendance-player-title">
	                <text class="player-pool-number">{{item.numberText}}</text>
	                <text>{{item.name}}</text>
	                <text class="player-level-tag {{item.levelClass}}">{{item.levelLabel}}</text>
	              </view>
	              <view class="subtle">{{item.meta}}</view>
	            </view>
	          </label>
	        </checkbox-group>
	        <view wx:if="{{!visibleAttendancePlayers.length}}" class="empty compact-empty">暂无匹配球员</view>
	      </view>
	      <button class="btn btn-primary" loading="{{saving}}" bindtap="submitAttendance">{{attendanceSubmitLabel}}</button>
	      <view class="history-list">
        <view wx:for="{{attendanceRecords}}" wx:key="id" class="history-row">
          <view class="history-main">
            <view class="history-title"><text>{{item.kindLabel}}</text><text> · {{item.dateText}}</text></view>
            <view class="subtle">{{item.noteText}}</view>
            <view wx:if="{{item.meta}}" class="subtle">{{item.meta}}</view>
          </view>
          <button class="link tiny-link danger-link" data-id="{{item.id}}" bindtap="deleteAttendanceRecord">删除</button>
        </view>
        <view wx:if="{{!attendanceRecords.length}}" class="empty compact-empty">暂无签到记录</view>
      </view>
    </view>
  </view>

  <view wx:if="{{isAdmin}}" class="section card panel stack">
    <view>
      <view class="eyebrow">🏛 荣誉</view>
      <view class="card-title">名人堂授予</view>
    </view>
    <input class="input" type="number" placeholder="入选年份" value="{{hofYear}}" bindinput="onHofYearInput" />
    <textarea class="textarea compact" placeholder="入选理由，例如赛季 MVP、长期贡献、关键比赛表现" value="{{hofReason}}" bindinput="onHofReasonInput" />
    <view class="request-actions">
      <button class="btn btn-primary small-btn" loading="{{saving}}" bindtap="addHallOfFame">加入名人堂</button>
      <button class="btn btn-danger small-btn" loading="{{saving}}" bindtap="removeHallOfFame">移出名人堂</button>
    </view>
    <view class="subtle">使用上方选中的球员；移出名人堂不会删除球员档案或比赛数据。</view>
  </view>

  <view wx:if="{{isAdmin && canReadAudit}}" class="section card panel stack">
    <view class="row between">
      <view>
        <view class="eyebrow">🧭 审计</view>
        <view class="card-title">最近操作</view>
      </view>
      <view class="audit-actions">
        <button class="link" bindtap="go" data-url="/pages/admin/audit/audit">详情</button>
        <button class="link" bindtap="load">刷新</button>
      </view>
    </view>
    <view wx:for="{{auditLogs}}" wx:key="id" class="audit-row">
      <view class="audit-title">{{item.title}}</view>
      <view class="subtle">{{item.actorText}}</view>
      <view class="subtle">{{item.meta}}</view>
      <view wx:if="{{item.timeText}}" class="audit-time">{{item.timeText}}</view>
    </view>
    <view wx:if="{{!auditLogs.length}}" class="empty compact-empty">暂无审计记录</view>
  </view>

  <view wx:if="{{isAdmin}}" class="section card panel stack">
    <view>
      <view class="eyebrow">⚡ 快捷</view>
      <view class="card-title">常用入口</view>
    </view>
    <view class="shortcut-grid">
      <button class="shortcut card" bindtap="go" data-url="/pages/events/event-create/event-create">
        <text class="shortcut-icon">📌</text>
        <text>发起接龙</text>
      </button>
      <button class="shortcut card" bindtap="go" data-url="/pages/score/create/create">
        <text class="shortcut-icon">⚾</text>
        <text>新建比赛</text>
      </button>
      <button class="shortcut card" bindtap="go" data-url="/pages/games/game-import/game-import">
        <text class="shortcut-icon">📄</text>
        <text>数据导入</text>
      </button>
      <button class="shortcut card" bindtap="go" data-url="/pages/players/player-list/player-list">
        <text class="shortcut-icon">👥</text>
        <text>球员阵容</text>
      </button>
      <button class="shortcut card" bindtap="go" data-url="/pages/hall-of-fame/hall-of-fame">
        <text class="shortcut-icon">🏛</text>
        <text>名人堂</text>
      </button>
      <button class="shortcut card" bindtap="go" data-url="/pages/highlights/highlights">
        <text class="shortcut-icon">📸</text>
        <text>精彩时刻</text>
      </button>
      <button class="shortcut card" bindtap="go" data-url="/pages/notifications/notifications">
        <text class="shortcut-icon">🔔</text>
        <text>站内通知</text>
      </button>
      <button wx:if="{{canReadAudit}}" class="shortcut card" bindtap="go" data-url="/pages/admin/audit/audit">
        <text class="shortcut-icon">🧭</text>
        <text>审计日志</text>
      </button>
    </view>
    <view class="subtle">比赛 PDF / Excel 可在小程序解析预览后入库；星阵配置由上方“星阵全站发布”同步到网页。</view>
  </view>
</view>
