.profile {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar-lg {
  width: 132rpx;
  height: 132rpx;
  border: 2rpx solid rgba(228, 199, 122, .55);
  border-radius: 50%;
  background: #0f1e38;
}

.quick {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.quick-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 calc((100% - 16rpx) / 2);
  width: calc((100% - 16rpx) / 2);
  min-width: 0;
  min-height: 108rpx;
  color: #f6f8ff;
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
  word-break: keep-all;
}

.bind-cta {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 18rpx;
  border-color: rgba(228, 199, 122, .42);
  background:
    linear-gradient(135deg, rgba(228, 199, 122, .18), rgba(143, 176, 255, .12)),
    rgba(10, 22, 40, .9);
}

.bind-cta-title {
  margin: 8rpx 0;
  color: #f6f8ff;
  font-size: 34rpx;
  font-weight: 900;
}

.bind-cta-btn {
  min-height: 82rpx;
}

.card-title {
  margin-bottom: 14rpx;
  color: #f6f8ff;
  font-size: 30rpx;
  font-weight: 760;
}

.link {
  min-height: 48rpx;
  padding: 0 14rpx;
  color: #e4c77a;
  background: transparent;
  font-size: 23rpx;
  font-weight: 800;
}

.public-preview {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 96rpx;
}

.preview-avatar {
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  border: 2rpx solid rgba(228, 199, 122, .38);
  border-radius: 50%;
  background: #0f1e38;
}

.avatar-action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.small-action {
  min-height: 64rpx;
  font-size: 23rpx;
}

.row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 76rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.item-title {
  color: #f6f8ff;
  font-size: 26rpx;
  font-weight: 700;
}

.signup-note {
  margin-top: 6rpx;
  color: #c8d4ea;
  font-size: 23rpx;
}

.status-pill {
  flex: 0 0 auto;
  min-width: 88rpx;
  padding: 8rpx 12rpx;
  border: 1rpx solid rgba(228, 199, 122, .36);
  border-radius: 999rpx;
  color: #e4c77a;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.status-pill.tentative {
  border-color: rgba(91, 139, 255, .45);
  color: #b9caff;
}

.status-pill.cancelled {
  border-color: rgba(255, 138, 138, .35);
  color: #ffb4b4;
}

.status-pill.pending {
  border-color: rgba(228, 199, 122, .42);
  color: #e4c77a;
}

.status-pill.approved {
  border-color: rgba(111, 220, 160, .42);
  color: #9af1bd;
}

.status-pill.rejected {
  border-color: rgba(255, 138, 138, .35);
  color: #ffb4b4;
}

.login {
  margin-top: 28rpx;
}
