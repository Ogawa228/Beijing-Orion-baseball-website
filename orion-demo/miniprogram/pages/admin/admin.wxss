.admin-page .card-title {
  color: #f6f8ff;
  font-size: 30rpx;
  font-weight: 800;
}

.permission-track {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stat-card {
  min-height: 128rpx;
}

.stat-value {
  color: #e4c77a;
  font-size: 46rpx;
  font-weight: 900;
}

.link {
  min-width: 72rpx;
  min-height: 48rpx;
  color: #8fb0ff;
  font-size: 24rpx;
  font-weight: 800;
}

.compact {
  min-height: 96rpx;
}

.request-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.request-card:last-child {
  border-bottom: 0;
}

.request-title {
  color: #f6f8ff;
  font-size: 30rpx;
  font-weight: 850;
}

.request-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.request-status {
  flex: 0 0 auto;
  padding: 4rpx 14rpx;
  border: 1rpx solid currentColor;
  border-radius: 999rpx;
  color: #e4c77a;
  font-size: 20rpx;
  font-weight: 900;
}

.request-status.approved {
  color: #6ee7b7;
}

.request-status.rejected {
  color: #ffb7b7;
}

.note {
  margin-top: 8rpx;
  color: #dbe5f8;
  font-size: 24rpx;
  line-height: 1.5;
}

.invite-code {
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(228, 199, 122, .32);
  border-radius: 8rpx;
  background: rgba(228, 199, 122, .08);
  color: #e4c77a;
  font-size: 26rpx;
  font-weight: 900;
  word-break: break-all;
}

.account-action-box {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .08);
}

.admin-user-filters {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.admin-user-search {
  grid-column: 1 / -1;
}

.danger-zone {
  border-top-color: rgba(255, 95, 95, .22);
}

.danger-title {
  color: #ffb7b7 !important;
  font-size: 26rpx !important;
}

.danger-link {
  color: #ffb7b7;
}

.compact-title {
  font-size: 26rpx !important;
}

.request-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.small-btn {
  min-height: 66rpx;
  font-size: 24rpx;
}

.admin-group-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.admin-group-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 8rpx;
  color: #dbe5f8;
  font-size: 24rpx;
  font-weight: 800;
}

.player-merge-panel {
  border-color: rgba(228, 199, 122, .26);
}

.player-pool-box {
  padding-top: 0;
  border-top: 0;
}

.player-pool-tools {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 190rpx;
  gap: 12rpx;
  align-items: center;
}

.player-pool-tools .compact-input {
  margin-top: 0;
}

.player-pool-list {
  max-height: 620rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .08);
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.player-pool-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 190rpx;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.player-pool-row:last-child {
  border-bottom: 0;
}

.player-pool-main {
  min-width: 0;
}

.player-pool-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #f6f8ff;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.35;
}

.player-pool-number {
  color: #e4c77a;
  font-variant-numeric: tabular-nums;
}

.player-pool-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.player-level-tag {
  min-height: 38rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 850;
  line-height: 38rpx;
}

.player-level-tag.verified {
  color: #9af1bd;
  background: rgba(154, 241, 189, .12);
}

.player-level-tag.casual {
  color: #e4c77a;
  background: rgba(228, 199, 122, .12);
}

.player-pool-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
  align-content: flex-start;
}

.player-create-box {
  margin-top: 4rpx;
}

.create-player-photo-box {
  display: grid;
  gap: 12rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, .1);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .035);
}

.batch-photo-box {
  display: grid;
  gap: 12rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, .1);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .035);
}

.create-player-photo-head,
.batch-photo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #eef3ff;
  font-size: 24rpx;
  font-weight: 900;
}

.mini-subtle {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 800;
}

.create-player-photo-preview {
  width: 100%;
  height: 220rpx;
  border: 1rpx solid rgba(228, 199, 122, .22);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .04);
}

.create-photo-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.tournament-cover-box {
  display: grid;
  gap: 12rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, .1);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .035);
}

.tournament-cover-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #eef3ff;
  font-size: 24rpx;
  font-weight: 900;
}

.tournament-cover-preview {
  width: 100%;
  height: 260rpx;
  border: 1rpx solid rgba(228, 199, 122, .22);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .04);
}

.tournament-cover-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.player-batch-box {
  gap: 14rpx;
}

.batch-player-text {
  min-height: 180rpx;
  font-family: Menlo, Consolas, monospace;
}

.merge-options {
  display: flex;
}

.merge-option {
  width: 100%;
  min-height: 72rpx;
}

.merge-preview {
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, .1);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .04);
  color: #b7c2d9;
  font-size: 24rpx;
  line-height: 1.55;
}

.points-overview-box {
  padding-top: 0;
  border-top: 0;
}

.leaderboard-overview-row {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.leaderboard-overview-row:last-child {
  border-bottom: 0;
}

.leaderboard-overview-row.is-top .overview-rank,
.leaderboard-overview-row.is-top .overview-total {
  color: #e4c77a;
}

.overview-rank {
  color: #93a6c7;
  font-size: 32rpx;
  font-weight: 900;
  text-align: center;
}

.overview-main {
  min-width: 0;
}

.overview-name {
  color: #f6f8ff;
  font-size: 27rpx;
  font-weight: 850;
}

.overview-total {
  color: #f6f8ff;
  font-size: 34rpx;
  font-weight: 950;
}

.point-game-selector {
  display: grid;
  gap: 12rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(143, 176, 255, .18);
  border-radius: 8rpx;
  background: rgba(143, 176, 255, .055);
}

.point-game-label {
  margin: 4rpx 0;
  color: #f6f8ff;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.42;
}

.point-game-tools {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 180rpx;
  gap: 12rpx;
  align-items: center;
}

.point-game-tools .compact-input {
  margin-top: 0;
}

.load-more-games {
  justify-self: center;
  min-width: 220rpx;
  margin: 2rpx auto;
  padding: 0 20rpx;
}

.inline-load-more {
  margin-top: -2rpx;
}

.attendance-batch-box {
  display: grid;
  gap: 12rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .10);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .035);
}

.attendance-batch-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.attendance-batch-tools .compact-input {
  flex: 1 1 auto;
  min-width: 0;
  margin-top: 0;
}

.attendance-player-list {
  display: grid;
  gap: 8rpx;
  max-height: 420rpx;
  overflow-y: auto;
}

.attendance-player-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  min-height: 76rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, .08);
  border-radius: 8rpx;
  background: rgba(7, 18, 33, .58);
}

.attendance-player-main {
  min-width: 0;
  flex: 1 1 auto;
}

.attendance-player-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  color: #f6f8ff;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.35;
}

.bind-code-list {
  display: grid;
  gap: 12rpx;
}

.bind-code-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .10);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .035);
}

.bind-code-main {
  min-width: 0;
  flex: 1 1 auto;
}

.bind-code-value {
  color: #f6f8ff;
  font-size: 27rpx;
  font-weight: 850;
  word-break: break-all;
}

.bind-code-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex: 0 0 auto;
}

.bind-code-status {
  min-width: 92rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 850;
}

.bind-code-status.unused {
  background: rgba(154, 241, 189, .12);
  color: #9af1bd;
}

.bind-code-status.used {
  background: rgba(255, 255, 255, .08);
  color: #8fa0bb;
}

.bind-code-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tiny-link {
  min-width: 54rpx;
  min-height: 44rpx;
  padding: 0;
  font-size: 22rpx;
}

.audit-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.audit-row:last-child {
  border-bottom: 0;
}

.audit-title {
  color: #f6f8ff;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.45;
}

.audit-time {
  margin-top: 8rpx;
  color: #7f8fa9;
  font-size: 22rpx;
}

.audit-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 0 0 auto;
}

.two-col {
  display: grid;
  grid-template-columns: minmax(0, 210rpx) minmax(0, 1fr);
  gap: 12rpx;
}

.compact-picker {
  min-height: 74rpx;
  font-size: 24rpx;
}

.system-panel {
  border-color: rgba(143, 176, 255, .24);
}

.starfield-status {
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(143, 176, 255, .22);
  border-radius: 8rpx;
  background: rgba(143, 176, 255, .08);
  color: #b7c8ff;
  font-size: 24rpx;
  line-height: 1.45;
}

.starfield-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.starfield-control {
  min-width: 0;
  padding: 14rpx 14rpx 8rpx;
  border: 1rpx solid rgba(255, 255, 255, .10);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .035);
}

.setting-value {
  color: #e4c77a;
  font-size: 24rpx;
  font-weight: 850;
  font-variant-numeric: tabular-nums;
}

.compact-input {
  min-height: 68rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
}

.game-batch-box {
  gap: 16rpx;
}

.event-admin-tools {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 210rpx;
  gap: 12rpx;
  align-items: center;
}

.event-admin-tools .compact-input {
  margin-top: 0;
}

.game-batch-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.game-batch-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 0 0 auto;
}

.game-batch-list {
  display: flex;
  flex-direction: column;
  max-height: 560rpx;
  overflow: auto;
  border-top: 1rpx solid rgba(255, 255, 255, .08);
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.game-batch-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.game-batch-row:last-child {
  border-bottom: 0;
}

.game-batch-meta {
  min-width: 0;
  flex: 1;
}

.game-batch-title {
  color: #f6f8ff;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.35;
}

.event-row-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex: 0 0 auto;
}

.batch-delete-zone {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 16rpx;
}

.score-action-box {
  gap: 14rpx;
}

.history-list {
  display: grid;
  gap: 10rpx;
}

.history-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, .08);
}

.history-main {
  min-width: 0;
  flex: 1;
}

.history-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  color: #f6f8ff;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.45;
}

.score-delta {
  min-width: 72rpx;
  font-variant-numeric: tabular-nums;
}

.score-delta.positive {
  color: #9af1bd;
}

.score-delta.negative {
  color: #ffb7b7;
}

.shortcut-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.shortcut {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 88rpx;
  padding: 0 16rpx;
  color: #f6f8ff;
  font-size: 26rpx;
  font-weight: 800;
}

.shortcut-icon {
  font-size: 30rpx;
}

@media (max-width: 360px) {
  .starfield-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
