.orion-tabbar {
  position: relative;
  display: flex;
  align-items: flex-end;
  background: #0a1527;
  border-top: 1rpx solid rgba(255, 255, 255, .1);
  padding-bottom: env(safe-area-inset-bottom);
}

.orion-tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  min-height: 100rpx;
  padding: 12rpx 0 10rpx;
  color: #9aa9c4;
}

.orion-tabbar-icon {
  font-size: 36rpx;
  line-height: 1.2;
}

.orion-tabbar-text {
  margin-top: 2rpx;
  font-size: 22rpx;
  line-height: 1.3;
}

.orion-tabbar-item.is-active {
  color: #e4c77a;
}

.orion-tabbar-item.is-active .orion-tabbar-text {
  font-weight: 700;
}

/* 中央签到大钮:凸起金色圆钮,深底描边与底栏融合 */
.orion-tabbar-big {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  margin-top: -44rpx;
  border: 6rpx solid #0a1527;
  border-radius: 50%;
  background: #e4c77a;
  box-shadow: 0 10rpx 26rpx rgba(228, 199, 122, .32);
}

.orion-tabbar-big-text {
  color: #081120;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.orion-tabbar-item.is-primary.is-active .orion-tabbar-big {
  background: #f0d692;
}
