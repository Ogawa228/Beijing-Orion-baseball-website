.highlights-page .card-title {
  color: #f6f8ff;
  font-size: 30rpx;
  font-weight: 800;
}

.link {
  min-width: 72rpx;
  min-height: 52rpx;
  color: #8fb0ff;
  font-size: 24rpx;
  font-weight: 800;
}

.load-inline {
  align-self: flex-start;
  min-width: 220rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(155, 188, 255, .25);
  border-radius: 999rpx;
  background: rgba(155, 188, 255, .08);
}

.moments-scroll {
  width: 100%;
}

.moments-track {
  display: flex;
  gap: 18rpx;
  padding: 2rpx 2rpx 10rpx;
}

.moment-card {
  flex: 0 0 560rpx;
  width: 560rpx;
  overflow: hidden;
}

.moment-image,
.image-missing {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 330rpx;
  background: #0f1e38;
}

.image-missing {
  color: #9aa9c4;
  font-size: 26rpx;
}

.moment-body {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 22rpx;
}

.moment-title {
  color: #f6f8ff;
  font-size: 29rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pill.published {
  border-color: rgba(111, 220, 160, .42);
  color: #9af1bd;
}

.pill.pending {
  border-color: rgba(228, 199, 122, .42);
  color: #e4c77a;
}

.pill.rejected {
  border-color: rgba(255, 138, 138, .35);
  color: #ffb4b4;
}

.copy-link {
  flex: 0 0 auto;
  min-height: 44rpx;
  padding: 0 12rpx;
  color: #8fb0ff;
  font-size: 22rpx;
  font-weight: 800;
}

.moment-links {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.mini-link {
  flex: 1 1 150rpx;
  min-height: 54rpx;
  padding: 0 14rpx;
  border: 1rpx solid rgba(155, 188, 255, .25);
  border-radius: 999rpx;
  color: #9bbcff;
  background: rgba(155, 188, 255, .08);
  font-size: 22rpx;
  font-weight: 850;
}

.upload-box {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.upload-preview {
  width: 100%;
  height: 260rpx;
  border: 1rpx solid rgba(255, 255, 255, .1);
  border-radius: 14rpx;
  background: #0f1e38;
}

.review-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.small-btn {
  flex: 1 1 calc((100% - 12rpx) / 2);
  min-width: 180rpx;
  min-height: 66rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  margin: 18rpx 0 0;
  border: 1rpx solid rgba(155, 188, 255, .28);
  border-radius: 999rpx;
  color: #9bbcff;
  background: rgba(143, 176, 255, .08);
  font-size: 24rpx;
  font-weight: 850;
}
