.audit-page .card-title {
  color: #f6f8ff;
  font-size: 30rpx;
  font-weight: 800;
}

.filter-row,
.search-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.compact-picker {
  min-height: 74rpx;
  font-size: 24rpx;
}

.search-row {
  grid-template-columns: minmax(0, 1fr) 148rpx;
  align-items: center;
}

.search-input {
  min-width: 0;
}

.search-btn {
  min-height: 76rpx;
  font-size: 24rpx;
}

.link {
  min-width: 72rpx;
  min-height: 48rpx;
  color: #8fb0ff;
  font-size: 24rpx;
  font-weight: 800;
}

.audit-card {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.audit-card:last-child {
  border-bottom: 0;
}

.audit-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.audit-action {
  color: #e4c77a;
  font-size: 24rpx;
  font-weight: 900;
}

.audit-time {
  flex: 0 0 auto;
  color: #7f8fa9;
  font-size: 22rpx;
}

.audit-title {
  color: #f6f8ff;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.45;
}

.detail-hint {
  margin-top: 8rpx;
  color: #9bbcff;
  font-size: 22rpx;
  font-weight: 800;
}

.detail-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  background: rgba(0, 0, 0, .58);
  box-sizing: border-box;
}

.detail-panel {
  width: 100%;
  max-height: 78vh;
  overflow-y: auto;
  padding: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, .14);
  border-radius: 8rpx;
  background: #071224;
  box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, .32);
  box-sizing: border-box;
}

.close-link {
  flex: 0 0 auto;
}

.detail-line {
  margin: 12rpx 0;
  color: #f6f8ff;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.5;
}

.metadata-box {
  margin: 18rpx 0;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, .1);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .04);
  color: #dbe5f8;
  font-family: monospace;
  font-size: 22rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}
