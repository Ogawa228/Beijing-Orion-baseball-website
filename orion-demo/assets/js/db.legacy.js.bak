const DB = {
  _data: null,

  init() {
    const raw = localStorage.getItem(DB_KEY);
    if (raw) {
      try {
        this._data = JSON.parse(raw);
        // 兜底补字段：v6 之后新增的数组（attendances / pointsAdjustments）老数据没有
        let dirty = false;
        if (!Array.isArray(this._data.attendances))      { this._data.attendances = [];      dirty = true; }
        if (!Array.isArray(this._data.pointsAdjustments)){ this._data.pointsAdjustments = []; dirty = true; }
        if (!Array.isArray(this._data._migrations))      { this._data._migrations = [];      dirty = true; }
        // ---------- 一次性迁移：清空赛季奖项类 titles + 名人堂（2026-05-09）----------
        // 用户决定：2026 赛季进行中，名人堂 / 赛季 MVP / 金手套 / 银棒 都不预设，
        // 等赛季结束 admin 手动加。这里清掉老 localStorage 的预制数据。
        // 用 _migrations 标记防止用户后续手动加的"赛季 MVP"被反复清掉。
        const MIG_KEY = 'clearSeasonAwards_2026_05_09';
        if (!this._data._migrations.includes(MIG_KEY)) {
          // 1. hallOfFame 整体清空（用户原话：「名人堂内容都先清空」）
          if (Array.isArray(this._data.hallOfFame) && this._data.hallOfFame.length) {
            this._data.hallOfFame = [];
          }
          // 2. titles 里"赛季奖项"类条目逐个剥离，保留"队长/工具人/守备核心"等日常称号
          //    覆盖：赛季 MVP / 赛季最佳 X / 金手套 / 金棒(误称) / 银棒奖 / 最佳投手 / 名人堂
          const SEASON_AWARD_RE = /赛季\s*MVP|赛季最佳|金手套|金棒|银棒|最佳投手|名人堂/i;
          (this._data.players || []).forEach(p => {
            if (Array.isArray(p.titles) && p.titles.length) {
              const cleaned = p.titles.filter(t => !SEASON_AWARD_RE.test(String(t)));
              if (cleaned.length !== p.titles.length) p.titles = cleaned;
            }
          });
          this._data._migrations.push(MIG_KEY);
          dirty = true;
        }
        // 兜底：所有 boundPlayerId 为空的 user（除 admin）→ 建 casual player 关联
        (this._data.users || []).forEach(u => {
          if (u.role === 'admin') return;
          if (u.boundPlayerId) return;
          const newId = 'p_user_' + u.id.replace(/^u_/, '');
          if (!this._data.players.find(p => p.id === newId)) {
            this._data.players.push({
              id: newId, name: u.displayName || u.email || '试训队员',
              number: '', position: '', photo: '',
              slogan: '', bats: '', throws: '', joinYear: new Date().getFullYear(),
              titles: [], level: 'casual'
            });
          }
          u.boundPlayerId = newId;
          dirty = true;
        });
        if (dirty) this._save();
        return;
      } catch(e) {}
    }
    this._data = JSON.parse(JSON.stringify(SEED));
    this._save();
  },

  // ----- player level helper（'casual' | 'verified'） -----
  // SEED 老 player 没 level 字段，默认当 verified；新注册的 casual 显式标记
  getPlayerLevel(player) {
    if (!player) return 'verified';
    return player.level || 'verified';
  },
  // 给定 playerId 算训练签到次数（用于 N/8 升级进度）
  getTrainingCount(playerId) {
    return this._data.attendances.filter(a => a.playerId === playerId && a.kind === 'training').length;
  },
  // 升级 player 到 verified（满 8 次训练 / admin 手动 / 绑定码触发）
  upgradePlayerToVerified(playerId, opts = {}) {
    const p = this.getPlayerById(playerId);
    if (!p) return null;
    if (this.getPlayerLevel(p) === 'verified') return p;
    p.level = 'verified';
    p.upgradedAt = new Date().toISOString();
    p.upgradedBy = opts.reason || 'auto';  // 'auto' | 'admin' | 'bindcode'
    this._save();
    return p;
  },

  _save() {
    try {
      localStorage.setItem(DB_KEY, JSON.stringify(this._data));
    } catch (err) {
      const isQuota = err && (
        err.name === 'QuotaExceededError' ||
        err.code === 22 ||
        /quota/i.test(err.message || '')
      );
      if (isQuota) {
        const total = JSON.stringify(this._data).length;
        const games = this._data.games?.length || 0;
        const e = new Error(
          'localStorage 存储已满（约 ' + (total/1024).toFixed(0) + ' KB，' + games +
          ' 场比赛）。Demo 版本数据存在浏览器，请清理过往比赛或图片后重试。\n' +
          '正式部署后建议接入对象存储（COS）保存图片，仅在 localStorage 留元数据。'
        );
        e.cause = err;
        throw e;
      }
      throw err;
    }
  },

  reset() {
    localStorage.removeItem(DB_KEY);
    localStorage.removeItem(SESSION_KEY);
    this.init();
  },

  // --- users / auth ---
  findUserByEmail(email) {
    return this._data.users.find(u => u.email.toLowerCase() === email.toLowerCase());
  },
  register({ email, password, displayName }) {
    if (this.findUserByEmail(email)) throw new Error('邮箱已被注册');
    // 注册时立即建一个 casual player 档案（用 displayName 作 name），
    // 让 attendance / pointsAdjustments 有 playerId 可挂——账本统一
    // ID 加随机后缀防止 1ms 内多次注册时 Date.now() 撞车
    const rand = Math.random().toString(36).slice(2,7);
    const userId = 'u_' + Date.now() + '_' + rand;
    const playerId = 'p_user_' + Date.now() + '_' + rand;
    const casualPlayer = {
      id: playerId, name: displayName, number: '', position: '', photo: '',
      slogan: '', bats: '', throws: '', joinYear: new Date().getFullYear(),
      titles: [], level: 'casual'
    };
    this._data.players.push(casualPlayer);
    const user = {
      id: userId,
      email, password, displayName,
      role: 'player',
      boundPlayerId: playerId,    // 立刻绑定到 casual player
      createdAt: new Date().toISOString().slice(0,10),
      lastActiveAt: new Date().toISOString()
    };
    this._data.users.push(user);
    this._save();
    return user;
  },
  login(email, password) {
    const u = this.findUserByEmail(email);
    if (!u || u.password !== password) throw new Error('邮箱或密码错误');
    u.lastActiveAt = new Date().toISOString();
    this._save();
    localStorage.setItem(SESSION_KEY, JSON.stringify({ userId: u.id }));
    return u;
  },
  logout() { localStorage.removeItem(SESSION_KEY); },
  // 心跳：登录态下每 30 秒由 auth.js 调一次，更新 lastActiveAt（驱动在线状态）
  heartbeat() {
    const u = this.currentUser();
    if (!u) return;
    const target = this._data.users.find(x => x.id === u.id);
    if (!target) return;
    target.lastActiveAt = new Date().toISOString();
    this._save();
  },
  // 球员在线状态（≤2 min 在线 / ≤30 min 最近 / 否则离线）
  // 入参：player 对象。返回 { status:'online'|'recent'|'offline', lastActiveAt:ISO|null }
  // 通过 user.boundPlayerId 反查到注册账号
  getPlayerOnlineStatus(playerOrId) {
    const playerId = (typeof playerOrId === 'string') ? playerOrId : playerOrId?.id;
    if (!playerId) return { status: 'offline', lastActiveAt: null };
    const user = this._data.users.find(u => u.boundPlayerId === playerId);
    if (!user || !user.lastActiveAt) return { status: 'offline', lastActiveAt: null };
    const diff = Date.now() - new Date(user.lastActiveAt).getTime();
    if (diff < 2 * 60 * 1000)       return { status: 'online',  lastActiveAt: user.lastActiveAt };
    if (diff < 30 * 60 * 1000)      return { status: 'recent',  lastActiveAt: user.lastActiveAt };
    return { status: 'offline', lastActiveAt: user.lastActiveAt };
  },
  currentUser() {
    const s = localStorage.getItem(SESSION_KEY);
    if (!s) return null;
    try {
      const { userId } = JSON.parse(s);
      return this._data.users.find(u => u.id === userId) || null;
    } catch(e) { return null; }
  },

  // --- team identity ---
  // 判断一个队名是否属于"猎户"系
  // 慢投垒叫猎户座, 棒球叫猎户星, 甲组联赛叫 Zoo Park / ZPRK / Happy Zoo Park
  isOrionTeam(teamName) {
    if (!teamName) return false;
    return /猎户|Orion|Zoo\s*Park|ZPRK/i.test(String(teamName));
  },

  // --- players ---
  allPlayers() { return [...this._data.players]; },
  getPlayerById(id) { return this._data.players.find(p => p.id === id); },
  // Name lookup — also checks aliases[] so e.g. "靳江山" maps to 江山.
  // Resilient to whitespace + CJK-radical variations from PDF text extraction:
  //   "李 建 宇" / "李　建　宇" (全角) / "李 建 宇" (NBSP) / "靳江⼭" (Kangxi)
  //   / "陆海⻰" (Supplement radical) → all canonicalize to the registered name.
  getPlayerByName(name) {
    if (!name) return null;
    // Simplified-Chinese radicals NFKC misses — keep in sync with parser.js.
    const RAD = {'\u2EE2':'马','\u2EE6':'鸟','\u2EE9':'黄','\u2ED1':'长','\u2ED3':'长','\u2ED4':'门','\u2ED8':'青','\u2EDC':'飞','\u2EF0':'龙','\u2EF2':'龟','\u2EE5':'见','\u2EE7':'角'};
    const norm = s => String(s||'')
      .normalize('NFKC')
      .replace(/[\u2E80-\u2EFF]/g, ch => RAD[ch] || ch)
      .replace(/[\s\u00A0\u3000\u200B-\u200D\uFEFF]+/g, '')
      .toLowerCase();
    const q = String(name).trim();

    // 1. Exact match (raw)
    const exact = this._data.players.find(p => p.name === q);
    if (exact) return exact;

    // 2. Alias match (raw)
    const alias = this._data.players.find(p => Array.isArray(p.aliases) && p.aliases.includes(q));
    if (alias) return alias;

    // 3. Suffix-strip fuzzy ("曹山 pro" → "曹山")
    const stripped = q.replace(/\s+(pro|asst|sub|mgr|coach|alt)\s*$/i, '')
                      .replace(/\s+#?\d{1,3}\s*$/, '')
                      .replace(/[\s\u00A0\u3000\u200B-\u200D\uFEFF]+/g, ' ').trim();
    if (stripped !== q) {
      const fuzzy = this._data.players.find(p => p.name === stripped);
      if (fuzzy) return fuzzy;
    }

    // 4. Full canonicalization: NFKC + radical map + whitespace strip + case fold.
    const qN = norm(q);
    if (!qN) return null;
    let hit = this._data.players.find(p => norm(p.name) === qN);
    if (hit) return hit;
    hit = this._data.players.find(p =>
      Array.isArray(p.aliases) && p.aliases.some(a => norm(a) === qN)
    );
    if (hit) return hit;
    // 4c. Prefix / contains — only when query is at least 2 chars (avoid
    //     single-char wild matches). Returns first match.
    if (qN.length >= 2) {
      hit = this._data.players.find(p => {
        const pN = norm(p.name);
        return pN.startsWith(qN) || qN.startsWith(pN) ||
               pN.includes(qN)   || qN.includes(pN);
      });
      if (hit) return hit;
    }
    return null;
  },
  // Canonical name for a raw name (from game data) — returns the name we store under
  canonicalName(rawName) {
    const p = this.getPlayerByName(rawName);
    return p ? p.name : rawName;
  },
  // Canonical key for fuzzy name comparison.
  //
  // 把所有"长得一样但码点不同"的中文名归到同一个 key，覆盖 6 个层次：
  //   ① CJK Kangxi Radicals (U+2F00-U+2FDF) — NFKC 自动映射 (⼀⼭⽴⼦⾠ ...)
  //   ② CJK Supplement Radicals (U+2E80-U+2EFF) — 手工 RAD 映射 (⻰⻜⻩⻢ ...)
  //   ③ 繁体 → 简体 — TRAD2SIMP_MAP 全量表（2855 字，从 chinese-conv 提取）
  //   ④ 多类空白（ASCII / NBSP / 全角 / 零宽 / BOM） — 全剥离
  //   ⑤ 常见标点（中点 · ・，连字符等） — 全剥离
  //   ⑥ 大小写折叠
  // 三处必须共用此 key：写入侧 normalizeName / 查询侧 getPlayerByName / 聚合侧
  // (getPlayerStats + tournament.html leaderboard + dashboard.html per-game).
  canonicalNameKey(name) {
    if (!name) return '';
    const RAD = {'\u2EE2':'马','\u2EE6':'鸟','\u2EE9':'黄','\u2ED1':'长','\u2ED3':'长','\u2ED4':'门','\u2ED8':'青','\u2EDC':'飞','\u2EF0':'龙','\u2EF2':'龟','\u2EE5':'见','\u2EE7':'角'};
    let s = String(name)
      .normalize('NFKC')
      .replace(/[\u2E80-\u2EFF]/g, ch => RAD[ch] || ch);
    let out = '';
    for (const ch of s) out += _TRAD2SIMP_MAP[ch] || ch;
    return out
      .replace(/[\s\u00A0\u3000\u200B-\u200D\uFEFF]+/g, '')
      .replace(/[\u00B7\u30FB\u2022\u002E\uFF0E\-\u2014\u2013_]/g, '')
      .toLowerCase();
  },

  // All canonical-key variants matching a player. Used when aggregating
  // stats across games — old game data may store names in non-canonical
  // form (Kangxi radicals, mixed whitespace), so we compare on canonical key.
  playerNameKeys(player) {
    const keys = new Set([this.canonicalNameKey(player.name)]);
    if (Array.isArray(player.aliases)) {
      for (const a of player.aliases) keys.add(this.canonicalNameKey(a));
    }
    return keys;
  },
  // Alias-aware canonical key for a raw name from a batting/pitching record.
  // 把球员的所有别名（aliases）跟主名归到同一个 key——这样 g.batting 里写
  // "靳江山" 的那场，aggregation 时也会被算到注册名 "江山" 名下。
  // 流程：rawName → getPlayerByName 命中注册球员 → 返回该球员主名的 canonical key；
  // 没命中 → 返回 rawName 的 canonical key（对手球员等用）
  playerCanonicalKey(rawName) {
    if (!rawName) return '';
    const player = this.getPlayerByName(rawName);
    if (player) return this.canonicalNameKey(player.name);
    return this.canonicalNameKey(rawName);
  },
  addPlayer(data) {
    const id = 'p_' + Date.now();
    const p = {
      id,
      name: (data.name||'').trim(),
      number: data.number || '',
      position: data.position || '',
      photo: data.photo || '',
      slogan: (data.slogan||'').slice(0, SLOGAN_MAX),
      bats: data.bats || '',
      throws: data.throws || '',
      joinYear: data.joinYear || '',
      titles: Array.isArray(data.titles) ? data.titles.filter(Boolean) : [],
      level: data.level || 'verified',  // admin 加的球员默认正式
    };
    this._data.players.push(p);
    this._save();
    return p;
  },
  updatePlayer(id, updates) {
    const p = this.getPlayerById(id);
    if (!p) return null;
    if (updates.slogan !== undefined) updates.slogan = (updates.slogan||'').slice(0, SLOGAN_MAX);
    if (updates.titles !== undefined && Array.isArray(updates.titles)) updates.titles = updates.titles.filter(Boolean);
    Object.assign(p, updates);
    this._save();
    return p;
  },
  deletePlayer(id) {
    this._data.players = this._data.players.filter(p => p.id !== id);
    this._data.bindCodes = this._data.bindCodes.filter(c => c.playerId !== id);
    this._data.hallOfFame = this._data.hallOfFame.filter(h => h.playerId !== id);
    this._save();
  },

  // --- bind codes ---
  allBindCodes() { return [...this._data.bindCodes]; },
  createBindCode(playerId) {
    const code = 'ORION-' + Math.random().toString(36).slice(2,6).toUpperCase() + '-' + Math.random().toString(36).slice(2,6).toUpperCase();
    const entry = { code, playerId, used: false, createdAt: new Date().toISOString().slice(0,10) };
    this._data.bindCodes.push(entry);
    this._save();
    return entry;
  },
  redeemBindCode(userId, code) {
    const entry = this._data.bindCodes.find(c => c.code === code);
    if (!entry) throw new Error('绑定码无效');
    if (entry.used) throw new Error('该绑定码已被使用');
    const user = this._data.users.find(u => u.id === userId);
    if (!user) throw new Error('用户不存在');
    const targetPlayer = this.getPlayerById(entry.playerId);
    if (!targetPlayer) throw new Error('绑定码关联的球员不存在');
    // 数据迁移：把 user 之前 casual player 上的 attendance + pointsAdjustments 全部迁到 targetPlayer
    const previousId = user.boundPlayerId;
    if (previousId && previousId !== entry.playerId) {
      const previousPlayer = this.getPlayerById(previousId);
      // 只迁 casual player 的数据；如果之前已经是 verified，不动（防意外覆盖）
      if (previousPlayer && this.getPlayerLevel(previousPlayer) === 'casual') {
        this._data.attendances.forEach(a => { if (a.playerId === previousId) a.playerId = entry.playerId; });
        this._data.pointsAdjustments.forEach(adj => { if (adj.playerId === previousId) adj.playerId = entry.playerId; });
        // 删除老 casual player（不再需要）
        this._data.players = this._data.players.filter(p => p.id !== previousId);
      }
    }
    user.boundPlayerId = entry.playerId;
    user.displayName = targetPlayer.name;
    // 确保目标 player 是 verified（绑定码默认指向 verified；防御性升级）
    if (this.getPlayerLevel(targetPlayer) === 'casual') {
      this.upgradePlayerToVerified(entry.playerId, { reason: 'bindcode' });
    }
    entry.used = true;
    entry.usedBy = userId;
    entry.usedAt = new Date().toISOString().slice(0,10);
    this._save();
    return targetPlayer;
  },
  deleteBindCode(code) {
    this._data.bindCodes = this._data.bindCodes.filter(c => c.code !== code);
    this._save();
  },

  // --- games ---
  // includeAggregate: true to include season-aggregate synthetic games
  allGames(opts = {}) {
    const list = [...this._data.games];
    if (opts.includeAggregate) return list;
    return list.filter(g => !g.isAggregate);
  },
  getGameById(id) { return this._data.games.find(g => g.id === id); },
  addGame(game) {
    game.id = game.id || 'g_' + Date.now();
    this._data.games.push(game);
    this._save();
    return game;
  },
  updateGame(id, updates) {
    const g = this.getGameById(id);
    if (!g) return null;
    Object.assign(g, updates);
    this._save();
    return g;
  },
  deleteGame(id) {
    this._data.games = this._data.games.filter(g => g.id !== id);
    this._save();
  },
  // Player aggregated stats across all games.
  // filter: { tournamentId, season, gameId } — all optional.
  //
  // ★★★ 重要业务规则 ★★★
  // 联赛允许同一球员最多在 3 个队伍上场（借调机制）。一个注册的猎户座球员
  // 偶尔会以"客队"身份出现在某场比赛的 g.oppBatting 里。
  // **这种借调到对手队的数据不算他的赛季统计**——只统计他作为猎户座一方
  // 上场的场次，即只迭代 g.batting / g.pitching，**永远不要**把
  // g.oppBatting / g.oppPitching 加进来。
  // 见 DESIGN_BRIEF.md §8 "球员借调规则"。
  getPlayerStats(playerName, filter = {}) {
    let AB=0,R=0,H=0,RBI=0,BB=0,SO=0,games=0;
    let _1B=0,_2B=0,_3B=0,HR=0;   // extras for accurate SLG
    const perGame = [];
    // Build set of CANONICAL keys this player is known by (name + aliases).
    // Comparison uses canonicalNameKey so "董⽴彬" (Kangxi radical) matches
    // "董立彬" (normal CJK), "李 建 宇" with stray spaces matches "李建宇", etc.
    const player = this.getPlayerByName(playerName);
    const nameKeys = player ? this.playerNameKeys(player) : new Set([this.canonicalNameKey(playerName)]);
    this._data.games.forEach(g => {
      if (filter.tournamentId && g.tournamentId !== filter.tournamentId) return;
      if (filter.season && !(g.date||'').startsWith(filter.season)) return;
      if (filter.gameId && g.id !== filter.gameId) return;
      // ONLY look at g.batting (Orion's roster). NEVER include g.oppBatting,
      // even if the player's name happens to match a row there — that means
      // they were borrowed by the opponent for that game (per league rule).
      const line = (g.batting||[]).find(b => nameKeys.has(this.canonicalNameKey(b.name)));
      if (line) {
        AB+=line.AB; R+=line.R; H+=line.H; RBI+=line.RBI; BB+=line.BB; SO+=line.SO;
        _1B += (line._1B||0); _2B += (line._2B||0); _3B += (line._3B||0); HR += (line.HR||0);
        games += (line.gp || 1);  // aggregate lines carry a gp (games played) count
        const isHomeOrion = this.isOrionTeam(g.home);
        perGame.push({ gameId:g.id, opponent: isHomeOrion ? g.away : g.home, date:g.date, isAggregate: !!g.isAggregate, ...line });
      }
    });
    const AVG = AB ? (H/AB) : 0;
    const OBP = (AB+BB) ? ((H+BB)/(AB+BB)) : 0;
    const hasExtras = (_1B+_2B+_3B+HR) > 0;
    const totalBases = hasExtras ? (_1B + 2*_2B + 3*_3B + 4*HR) : (H * 1.5);
    const SLG = AB ? (totalBases/AB) : 0;
    const OPS = OBP + SLG;
    return { AB, R, H, RBI, BB, SO, games, AVG, OBP, SLG, OPS, _1B, _2B, _3B, HR, hasExtras, perGame };
  },

  // --- tournaments ---
  allTournaments(filter={}) {
    return this._data.tournaments.filter(t =>
      (!filter.type || t.type === filter.type) &&
      (!filter.season || t.season === filter.season)
    );
  },
  getTournamentById(id) { return this._data.tournaments.find(t => t.id === id); },
  addTournament(t) {
    t.id = t.id || 't_' + Date.now();
    this._data.tournaments.push(t);
    this._save();
    return t;
  },
  updateTournament(id, updates) {
    const t = this.getTournamentById(id);
    if (!t) return null;
    Object.assign(t, updates);
    this._save();
    return t;
  },
  deleteTournament(id) {
    this._data.tournaments = this._data.tournaments.filter(t => t.id !== id);
    // Games keep their tournamentId (may become dangling) — UI handles missing FK gracefully
    this._save();
  },
  getGamesForTournament(tournamentId) {
    return this._data.games.filter(g => g.tournamentId === tournamentId);
  },
  // Enumerate all unique seasons across tournaments + games
  allSeasons() {
    const set = new Set();
    this._data.tournaments.forEach(t => t.season && set.add(t.season));
    this._data.games.forEach(g => g.date && set.add(g.date.slice(0,4)));
    return [...set].sort((a,b) => b.localeCompare(a));
  },

  // --- highlights ---
  allHighlights() { return [...this._data.highlights]; },
  highlightsForGame(gameId) { return this._data.highlights.filter(h => h.gameId === gameId); },
  highlightsForPlayer(playerName) { return this._data.highlights.filter(h => h.playerName === playerName); },
  addHighlight(h) {
    h.id = 'h_' + Date.now();
    h.status = h.status || 'pending';
    this._data.highlights.push(h);
    this._save();
    return h;
  },
  deleteHighlight(id) {
    this._data.highlights = this._data.highlights.filter(h => h.id !== id);
    this._save();
  },

  // --- events ---
  allEvents() {
    // Newest first by createdAt then date
    return [...this._data.events].sort((a,b) => (b.createdAt||'').localeCompare(a.createdAt||''));
  },
  getEventById(id) { return this._data.events.find(e => e.id === id); },
  addEvent(ev) {
    ev.id = ev.id || 'ev_' + Date.now();
    ev.createdAt = ev.createdAt || new Date().toISOString().slice(0,10);
    ev.images = ev.images || [];
    this._data.events.push(ev);
    this._save();
    return ev;
  },
  updateEvent(id, updates) {
    const e = this.getEventById(id);
    if (!e) return null;
    Object.assign(e, updates);
    this._save();
    return e;
  },
  deleteEvent(id) {
    this._data.events = this._data.events.filter(e => e.id !== id);
    this._save();
  },

  // --- hall of fame ---
  allHallOfFame() {
    return this._data.hallOfFame.map(h => ({ ...h, player: this.getPlayerById(h.playerId) }));
  },
  addToHallOfFame(playerId, reason) {
    if (this._data.hallOfFame.find(h => h.playerId === playerId)) return;
    this._data.hallOfFame.push({ playerId, inductedYear: new Date().getFullYear(), reason });
    this._save();
  },
  removeFromHallOfFame(playerId) {
    this._data.hallOfFame = this._data.hallOfFame.filter(h => h.playerId !== playerId);
    this._save();
  },

  // ========================================================================
  // 积分系统（Points）
  // ========================================================================
  // 公式（与 2026-05-09 用户确认 / DESIGN_BRIEF §11 同步）：
  //   出场基础：训练 +5 / 友谊·训练赛 +10 / 联赛·杯赛 +15 / 活动 +5
  //   比赛表现：MVP +10 · HR +10/支 · 3B +3/支 · 2B +2/支 · 1B +1/支
  //             RBI +2/分 · SO(投手) +3/次 · BB(投手) -3/次
  //             E -3/次（admin 手动）· 1B/2B/3B/HR 仅棒球 PDF 可拆分时启用
  //   赛季奖项：赛季 MVP +100 / 金手套 +50 / 银棒 +50 / 名人堂 +200（一次性）
  // 计分原则：
  //   - 安打分级：batting 行有 _1B/_2B/_3B/HR 字段就分级；没有就把 H 全当 1B（每支 +1）
  //   - 借调规则：只看 g.batting / g.pitching（猎户座一方），永远不看 oppBatting
  //   - 不重复：getPlayerStats 同款 nameKeys（含 alias 反查）
  // ========================================================================

  // 训练 / 活动签到流水
  allAttendances() { return [...this._data.attendances]; },
  attendancesForPlayer(playerId) {
    return this._data.attendances.filter(a => a.playerId === playerId);
  },
  recordAttendance({ playerId, kind, refId, date, note, createdBy }) {
    if (!playerId || !kind) throw new Error('playerId / kind 必填');
    if (kind !== 'training' && kind !== 'event') throw new Error('kind 必须是 training 或 event');
    const entry = {
      id: 'att_' + Date.now() + '_' + Math.random().toString(36).slice(2,5),
      playerId, kind, refId: refId || null,
      date: date || new Date().toISOString().slice(0,10),
      note: note || '',
      createdBy: createdBy || null,
      createdAt: new Date().toISOString()
    };
    this._data.attendances.push(entry);
    this._save();
    // 钩子：自动升级 casual → verified（满 8 次训练）
    if (kind === 'training') {
      const player = this.getPlayerById(playerId);
      if (player && this.getPlayerLevel(player) === 'casual' && this.getTrainingCount(playerId) >= 8) {
        this.upgradePlayerToVerified(playerId, { reason: 'auto' });
        entry._triggeredUpgrade = true;
      }
    }
    return entry;
  },
  removeAttendance(id) {
    this._data.attendances = this._data.attendances.filter(a => a.id !== id);
    this._save();
  },

  // 管理员手动加减分流水
  allPointsAdjustments() { return [...this._data.pointsAdjustments]; },
  adjustmentsForPlayer(playerId) {
    return this._data.pointsAdjustments.filter(a => a.playerId === playerId);
  },
  addPointsAdjustment({ playerId, delta, reason, createdBy }) {
    if (!playerId) throw new Error('playerId 必填');
    const n = Number(delta);
    if (!Number.isFinite(n) || n === 0) throw new Error('delta 必须是非零数字');
    const entry = {
      id: 'adj_' + Date.now() + '_' + Math.random().toString(36).slice(2,5),
      playerId,
      delta: n,
      reason: reason || '',
      createdBy: createdBy || null,
      createdAt: new Date().toISOString()
    };
    this._data.pointsAdjustments.push(entry);
    this._save();
    return entry;
  },
  removePointsAdjustment(id) {
    this._data.pointsAdjustments = this._data.pointsAdjustments.filter(a => a.id !== id);
    this._save();
  },

  // 积分公式常量（外部可读）
  POINTS_RULES: {
    training:        5,
    friendlyOrTraining: 10,
    leagueOrCup:     15,
    event:           5,
    mvp:            10,
    hr:             10,
    triple:          3,
    double:          2,
    single:          1,
    rbi:             2,
    so:              3,
    bb_pitcher:     -3,
    seasonMvp:     100,
    goldGlove:      50,
    silverBat:      50,
    hallOfFame:    200,
  },

  // 计算单个球员的积分明细
  // 返回：{
  //   total, breakdown:{base, performance, awards, manual},
  //   timeline: [{date, source:'game'|'training'|'event'|'award'|'hof'|'manual',
  //               refId, label, delta, detail?}],
  // }
  getPlayerPoints(playerId) {
    const player = this.getPlayerById(playerId);
    if (!player) return { total: 0, breakdown:{base:0,performance:0,awards:0,manual:0}, timeline: [] };
    const R = this.POINTS_RULES;
    const nameKeys = this.playerNameKeys(player);
    const timeline = [];
    let base = 0, performance = 0, awards = 0, manual = 0;

    // 1. 比赛积分（出场 + 表现）
    this._data.games.forEach(g => {
      if (g.isAggregate) return;  // 聚合行不算
      const tournament = this.getTournamentById(g.tournamentId);
      const tType = tournament?.type || 'friendly';
      const isLeagueOrCup = (tType === 'league' || tType === 'cup');
      const isFriendlyOrTraining = (tType === 'friendly' || tType === 'training');

      const battingLine = (g.batting||[]).find(b => nameKeys.has(this.canonicalNameKey(b.name)));
      const pitchingLine = (g.pitching||[]).find(p => nameKeys.has(this.canonicalNameKey(p.name)));
      if (!battingLine && !pitchingLine) return;

      // 出场积分
      const apperancePts = isLeagueOrCup ? R.leagueOrCup : R.friendlyOrTraining;
      base += apperancePts;
      const oppName = this.isOrionTeam(g.home) ? g.away : g.home;
      const detailParts = [`vs ${oppName||'对手'}`, isLeagueOrCup ? '联赛·杯赛' : '友谊·训练赛'];
      const perfPieces = [];

      // 单场 MVP
      let mvpBonus = 0;
      if (g.mvpPlayerName && nameKeys.has(this.canonicalNameKey(g.mvpPlayerName))) {
        mvpBonus = R.mvp;
        perfPieces.push(`MVP +${R.mvp}`);
      }

      // 打者表现
      let battingBonus = 0;
      if (battingLine) {
        const _1B = battingLine._1B || 0;
        const _2B = battingLine._2B || 0;
        const _3B = battingLine._3B || 0;
        const HR  = battingLine.HR  || 0;
        const hasGraded = (_1B + _2B + _3B + HR) > 0;
        if (hasGraded) {
          if (_1B) { battingBonus += _1B * R.single; perfPieces.push(`1B×${_1B} +${_1B*R.single}`); }
          if (_2B) { battingBonus += _2B * R.double; perfPieces.push(`2B×${_2B} +${_2B*R.double}`); }
          if (_3B) { battingBonus += _3B * R.triple; perfPieces.push(`3B×${_3B} +${_3B*R.triple}`); }
          if (HR)  { battingBonus += HR  * R.hr;     perfPieces.push(`HR×${HR} +${HR*R.hr}`); }
        } else {
          // fallback：H 当 1B（慢垒 / parser 未升级前的棒球）
          const H = battingLine.H || 0;
          if (H) { battingBonus += H * R.single; perfPieces.push(`H×${H} +${H*R.single}`); }
        }
        const RBI = battingLine.RBI || 0;
        if (RBI) { battingBonus += RBI * R.rbi; perfPieces.push(`RBI×${RBI} +${RBI*R.rbi}`); }
      }

      // 投手表现
      let pitchingBonus = 0;
      if (pitchingLine) {
        const SO = pitchingLine.SO || 0;
        const BB = pitchingLine.BB || 0;
        if (SO) { pitchingBonus += SO * R.so;        perfPieces.push(`SO×${SO} +${SO*R.so}`); }
        if (BB) { pitchingBonus += BB * R.bb_pitcher; perfPieces.push(`BB×${BB} ${BB*R.bb_pitcher}`); }
      }

      const perfTotal = mvpBonus + battingBonus + pitchingBonus;
      performance += perfTotal;
      const gameDelta = apperancePts + perfTotal;

      timeline.push({
        date: g.date,
        source: 'game',
        refId: g.id,
        label: `${isLeagueOrCup ? '🏆' : '⚾'} ${detailParts[0]} · ${detailParts[1]}`,
        delta: gameDelta,
        detail: {
          appearance: apperancePts,
          performance: perfTotal,
          pieces: perfPieces,
          tournamentName: tournament?.shortName || tournament?.name || '',
        }
      });
    });

    // 2. 训练 / 活动签到
    this._data.attendances
      .filter(a => a.playerId === playerId)
      .forEach(a => {
        const delta = (a.kind === 'training') ? R.training : R.event;
        base += delta;
        let label = '';
        if (a.kind === 'training') {
          label = `🏋 训练签到`;
        } else {
          const ev = a.refId ? this.getEventById(a.refId) : null;
          label = `🎉 活动出席${ev ? ' · ' + ev.title : ''}`;
        }
        timeline.push({
          date: a.date,
          source: a.kind,
          refId: a.refId,
          label,
          delta,
          detail: { note: a.note || '' }
        });
      });

    // 3. 赛季奖项（从 player.titles[] 字符串匹配）
    (player.titles || []).forEach(t => {
      if (!t) return;
      const lower = t.toString();
      let delta = 0, label = '';
      if (/赛季\s*MVP|赛季最佳/i.test(lower)) {
        delta = R.seasonMvp; label = `★ 赛季奖项 · ${t}`;
      } else if (/金手套/i.test(lower)) {
        delta = R.goldGlove; label = `🥇 金手套 · ${t}`;
      } else if (/银棒|银棒奖/i.test(lower)) {
        delta = R.silverBat; label = `🥈 银棒奖 · ${t}`;
      } else if (/最佳投手/i.test(lower)) {
        // 「最佳投手」按金手套同级
        delta = R.goldGlove; label = `🏅 最佳投手 · ${t}`;
      }
      // 名人堂从 hallOfFame 表算，titles 里的"名人堂"不重复计
      if (delta && !/名人堂/.test(lower)) {
        awards += delta;
        timeline.push({ date: '', source:'award', refId: null, label, delta, detail:{ title: t } });
      }
    });

    // 4. 名人堂（一次性）
    const hofEntry = this._data.hallOfFame.find(h => h.playerId === playerId);
    if (hofEntry) {
      awards += R.hallOfFame;
      timeline.push({
        date: hofEntry.inductedYear ? `${hofEntry.inductedYear}-01-01` : '',
        source: 'hof',
        refId: null,
        label: `🌟 入选名人堂`,
        delta: R.hallOfFame,
        detail: { reason: hofEntry.reason || '', year: hofEntry.inductedYear }
      });
    }

    // 5. 管理员手动调整
    this._data.pointsAdjustments
      .filter(a => a.playerId === playerId)
      .forEach(a => {
        manual += a.delta;
        timeline.push({
          date: (a.createdAt || '').slice(0,10),
          source: 'manual',
          refId: a.id,
          label: `⚙ 管理员调整${a.reason ? ' · ' + a.reason : ''}`,
          delta: a.delta,
          detail: { reason: a.reason || '', createdAt: a.createdAt }
        });
      });

    // 时间线倒序（最近的在前），同日期保序
    timeline.sort((a,b) => (b.date||'').localeCompare(a.date||''));

    return {
      total: base + performance + awards + manual,
      breakdown: { base, performance, awards, manual },
      timeline
    };
  },

  // 全员积分排行榜
  // filter: { season?: '2026'|'2025'|... } 后续可选；未实现时返回所有数据全量
  getPointsLeaderboard(filter = {}) {
    return this._data.players
      .map(p => {
        const points = this.getPlayerPoints(p.id);
        return {
          player: p,
          total: points.total,
          breakdown: points.breakdown,
          gamesCount: points.timeline.filter(t => t.source === 'game').length,
          mvpCount: points.timeline.filter(t => t.source === 'game' && /MVP/.test((t.detail?.pieces||[]).join(','))).length,
        };
      })
      .filter(row => row.total !== 0 || row.gamesCount > 0)
      .sort((a,b) => b.total - a.total);
  },

  // --- helpers ---
  playerPhotoUrl(player) {
    if (!player || !player.photo) return 'assets/img/logo.jpg';
    // Data URL (uploaded via admin) — use as-is
    if (player.photo.startsWith('data:')) return player.photo;
    // Already a relative path
    if (player.photo.startsWith('assets/')) return player.photo;
    // Bare filename — assume it lives in players/
    return 'assets/img/players/' + player.photo;
  },
  // Extract B站 BV id → iframe src
  videoEmbedUrl(url) {
    if (!url) return null;
    const bv = url.match(/BV[0-9A-Za-z]+/);
    if (bv) return `https://player.bilibili.com/player.html?bvid=${bv[0]}&page=1&high_quality=1&danmaku=0`;
    const yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{11})/);
    if (yt) return `https://www.youtube.com/embed/${yt[1]}`;
    return null;
  }
};

DB.init();

// Expose helpers globally for inline scripts
window.DB = DB;
window.SLOGAN_MAX = SLOGAN_MAX;

// Auto-mount universe starfield background on every page (pure DOM, no deps)
// NOTE: the old rotating galaxy spiral was removed — we now use a real
// moon-earthrise photograph as the hero backdrop (see style.css .sky-moon)
// and keep only the dust nebulae + starfield + signature stars here.
(function mountUniverse(){
  if (document.querySelector('.universe')) return;
  function build(){
    // Sub-pages (no .hero): inject NASA Milky Way photograph as the base backdrop
    if (!document.querySelector('.hero')) {
      const mw = document.createElement('div');
      mw.className = 'sky-milky-way';
      mw.setAttribute('aria-hidden','true');
      document.body.insertBefore(mw, document.body.firstChild);
    }

    const uni = document.createElement('div');
    uni.className = 'universe';
    uni.setAttribute('aria-hidden','true');
    uni.innerHTML = `
      <div class="universe-layer">
        <div class="universe-nebula n1"></div>
        <div class="universe-nebula n2"></div>
        <div class="universe-nebula n3"></div>
      </div>
      <svg class="universe-stars" preserveAspectRatio="xMidYMid slice" viewBox="0 0 1400 2400"></svg>
    `;
    document.body.appendChild(uni);

    // Generate starfield — reduced counts for performance
    // Sub-pages with NASA photo need fewer synthetic stars
    const svg = uni.querySelector('.universe-stars');
    const W = 1400, H = 2400;
    const hasMW = !!document.querySelector('.sky-milky-way');
    const scale = hasMW ? 0.3 : 1; // 70% fewer stars when real photo present
    let s = '';
    // Layer 1: Background dust
    const dustN = Math.round(120 * scale);
    for (let i=0; i<dustN; i++) {
      const x = Math.random() * W;
      const y = Math.random() * H;
      const tw = Math.random() < .15 ? ` twinkle d${(i%5)+1}` : '';
      const rad = 0.4 + Math.random() * 0.6;
      s += `<circle class="star star-sm${tw}" cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${rad.toFixed(2)}"/>`;
    }
    // Layer 2: Mid stars
    const midN = Math.round(40 * scale);
    for (let i=0; i<midN; i++) {
      const x = Math.random() * W;
      const y = Math.random() * H;
      const tw = Math.random() < .3 ? ` twinkle d${(i%5)+1}` : '';
      const rad = 1.0 + Math.random() * 0.7;
      s += `<circle class="star star-md${tw}" cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${rad.toFixed(2)}"/>`;
    }
    // Layer 3: Bright stars with glow
    const brightN = Math.round(12 * scale);
    for (let i=0; i<brightN; i++) {
      const x = Math.random() * W;
      const y = Math.random() * H;
      const rad = 1.8 + Math.random() * 0.9;
      s += `<circle class="star star-lg" cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${rad.toFixed(2)}"/>`;
    }
    // Layer 4: Star clusters (reduced)
    const clusterN = hasMW ? 2 : 4;
    for (let c = 0; c < clusterN; c++) {
      const cx = Math.random() * W;
      const cy = Math.random() * H;
      const count = 6 + Math.floor(Math.random() * 5);
      for (let i = 0; i < count; i++) {
        const ang = Math.random() * Math.PI * 2;
        const dist = Math.sqrt(-2 * Math.log(Math.random())) * 24;
        const x = cx + Math.cos(ang) * dist;
        const y = cy + Math.sin(ang) * dist;
        const rad = 0.5 + Math.random() * 0.8;
        s += `<circle class="star star-sm" cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${rad.toFixed(2)}"/>`;
      }
    }
    // Orion constellation — 7 bright stars at top
    const orion = [
      {x:380,y:240,r:6.5},{x:860,y:280,r:5.5},{x:820,y:480,r:4.5},
      {x:660,y:495,r:5},{x:505,y:510,r:4.5},{x:420,y:680,r:5},{x:900,y:660,r:6.8}
    ];
    orion.forEach((st,i)=>{ s += `<circle class="star star-xl twinkle d${(i%5)+1}" cx="${st.x}" cy="${st.y}" r="${st.r}"/>`; });
    svg.innerHTML = s;

    // --- Twin signature stars — mirrored pair in left & right margins ---
    const sigStarL = document.createElement('div');
    sigStarL.className = 'signature-star mirror';   // gold-tinted, lives in LEFT margin
    const sigStarR = document.createElement('div');
    sigStarR.className = 'signature-star primary';  // blue-tinted, lives in RIGHT margin
    uni.appendChild(sigStarL);
    uni.appendChild(sigStarR);

    const STAR_RADIUS = 42;   // half of 84px
    const STAR_BUFFER = 24;   // min gap between star and content

    function positionSignatureStars(){
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      if (vw < 900) {
        sigStarL.style.opacity = '0';
        sigStarR.style.opacity = '0';
        return;
      }

      const containerW = Math.min(1280, vw - 48);
      const sideMargin = (vw - containerW) / 2;

      // Need room on both sides
      if (sideMargin < STAR_RADIUS + STAR_BUFFER) {
        sigStarL.style.opacity = '0';
        sigStarR.style.opacity = '0';
        return;
      }
      sigStarL.style.opacity = '';
      sigStarR.style.opacity = '';

      // Scroll progress drives everything, directly tied to scroll velocity
      const scrollY = window.scrollY || window.pageYOffset || 0;
      const maxScroll = Math.max(1, (document.documentElement.scrollHeight || document.body.scrollHeight) - vh);
      const progress = Math.max(0, Math.min(1, scrollY / maxScroll));

      // Horizontal: both stars are parked in the middle of their respective margins
      const rightMarginCenter = (vw + containerW) / 2 + sideMargin / 2;
      const leftMarginCenter  = sideMargin / 2;
      // Tiny horizontal wiggle using cos — subtle breathing inside margins
      const wiggle = Math.cos(progress * Math.PI * 4) * Math.min(10, sideMargin * 0.08);
      const xR = rightMarginCenter + wiggle;
      const xL = leftMarginCenter  - wiggle;

      // Vertical: mirrored sine waves. Star R uses +sin, star L uses -sin.
      // Result: when R rises, L sinks — symmetric rotating-dumbbell effect.
      const yCenter = vh * 0.5;
      const yAmp    = vh * 0.3;
      const phase   = progress * Math.PI * 2.2;  // ~1.1 full oscillations across the page
      const offset  = yAmp * Math.sin(phase);
      const yR = yCenter + offset;
      const yL = yCenter - offset;

      sigStarR.style.transform = `translate(${xR}px, ${yR}px) translate(-50%, -50%)`;
      sigStarL.style.transform = `translate(${xL}px, ${yL}px) translate(-50%, -50%)`;
    }

    positionSignatureStars();
    // Throttle scroll with rAF
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => { positionSignatureStars(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });
    window.addEventListener('resize', positionSignatureStars);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', build, { once:true });
  } else {
    build();
  }
})();
