<view class="page">
  <view class="bind-hero card panel stack">
    <view class="eyebrow">🔗 球员绑定</view>
    <view class="title">申请绑定正式球员档案</view>
    <view class="subtle">不用关联码。登录后选择自己的正式球员档案，管理员审核通过后自动合并签到、积分和比赛数据。</view>
    <view class="steps">
      <view class="step">1 选档案</view>
      <view class="step">2 填核验</view>
      <view class="step">3 等审核</view>
    </view>
    <view class="search-row">
      <input class="input search-input" placeholder="搜索姓名 / 球衣号 / 位置" value="{{query}}" bindinput="onQueryInput" bindconfirm="searchPlayers" />
      <button class="btn btn-ghost search-btn" loading="{{loadingPlayers}}" bindtap="searchPlayers">搜索</button>
    </view>
  </view>

  <view wx:if="{{latestRequest}}" class="section status-card card panel">
    <view class="row between">
      <view>
        <view class="eyebrow">📝 审核状态</view>
        <view class="status-title">{{latestRequest.target}}</view>
      </view>
      <view class="status-pill {{latestRequest.statusClass}}">{{latestRequest.statusLabel}}</view>
    </view>
    <view class="subtle">{{latestRequest.meta || '管理员处理后会在这里和站内通知同步更新。'}}</view>
  </view>

  <view class="section card panel">
    <view wx:for="{{visiblePlayers}}" wx:key="id" class="player-row {{item.activeClass}}" bindtap="select" data-id="{{item.id}}">
      <image class="avatar" src="{{item.photo || '/assets/orion-default-player-avatar.png'}}" mode="aspectFill" lazy-load="{{true}}" />
      <view>
        <view class="name">#{{item.number || '-'}} {{item.name}}</view>
        <view class="subtle">{{item.position || '猎户座'}}</view>
      </view>
    </view>
    <button wx:if="{{playersHasMore}}" class="btn btn-ghost load-more" loading="{{loadingMorePlayers}}" disabled="{{loadingMorePlayers}}" bindtap="loadMorePlayers">加载更多球员</button>
    <view wx:if="{{loadingPlayers && !visiblePlayers.length}}" class="skeleton-group">
      <view class="skeleton-line"></view>
      <view class="skeleton-line short"></view>
    </view>
    <view wx:elif="{{!visiblePlayers.length}}" class="empty compact-empty">暂无匹配球员</view>
  </view>

  <view wx:if="{{selected}}" class="section selected-card card panel">
    <view class="eyebrow">✅ 已选球员</view>
    <view class="selected-main">#{{selected.number || '-'}} {{selected.name}}</view>
    <view class="subtle">{{selected.position || '猎户座'}} · 管理员审批通过后自动绑定</view>
  </view>

  <view class="section form-card card panel stack">
    <view>
      <view class="eyebrow">✅ 核验</view>
      <view class="card-title">核验信息</view>
      <view class="subtle">微信登录身份会自动关联；这里可补充管理员容易识别的信息。</view>
    </view>
    <input class="input" placeholder="队内昵称 / 微信昵称" value="{{nickname}}" bindinput="onNicknameInput" />
    <input class="input" placeholder="手机号后四位 / 备注（选填）" value="{{contactTail}}" bindinput="onContactInput" />
    <textarea class="textarea" placeholder="补充说明，可写参加时间、常用位置等" value="{{note}}" bindinput="onNoteInput" />
    <button class="btn btn-primary submit-btn" loading="{{saving}}" disabled="{{submitDisabled || saving}}" bindtap="submit">{{submitLabel}}</button>
  </view>
</view>
