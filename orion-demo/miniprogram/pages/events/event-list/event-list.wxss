.event-list-head {
  display: block;
}

.head-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  width: 100%;
}

.action-btn {
  flex: 1;
  width: 0;
  min-height: 64rpx;
  font-size: 24rpx;
}

.event-card {
  margin-bottom: 18rpx;
}

.event-cover {
  width: 100%;
  height: 260rpx;
  margin-bottom: 18rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .08);
}

.card-title {
  margin: 18rpx 0 8rpx;
  color: #f6f8ff;
  font-size: 32rpx;
  font-weight: 750;
}

.signup-count {
  color: #e4c77a;
  font-size: 26rpx;
  font-weight: 800;
}

.body {
  margin-top: 12rpx;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.load-more {
  min-height: 72rpx;
  margin: 14rpx 0 20rpx;
  border: 1rpx solid rgba(143, 176, 255, .26);
  border-radius: 8rpx;
  color: #8fb0ff;
  background: rgba(143, 176, 255, .08);
  font-size: 24rpx;
  font-weight: 800;
}
