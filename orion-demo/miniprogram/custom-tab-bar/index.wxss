.orion-tabbar {
  /* 自定义 tabBar 必须自己固定在底部,否则混在页面文档流里与内容重叠、切换时跟着重排闪烁 */
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #0a1527;
  border-top: 1rpx solid rgba(255, 255, 255, .07);
}

.orion-tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 108rpx;
  padding-bottom: 12rpx;
}

.orion-tabbar-ico {
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 4rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.orion-tabbar-text {
  font-size: 22rpx;
  line-height: 1.2;
  color: #7f8ca6;
}

.orion-tabbar-item.is-active .orion-tabbar-text {
  color: #e4c77a;
  font-weight: 600;
}

/* 中央签到:金色凸起圆钮,深底描边与底栏融合,柔和金色投影,内嵌矢量对勾 */
.orion-tabbar-item.is-primary .orion-tabbar-text {
  color: #e4c77a;
  font-weight: 600;
}

.orion-tabbar-big {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin-top: -46rpx;
  margin-bottom: 8rpx;
  border: 6rpx solid #0a1527;
  border-radius: 50%;
  background: #e4c77a;
  box-shadow: 0 8rpx 22rpx rgba(228, 199, 122, .3);
}

.orion-tabbar-big-ico {
  width: 50rpx;
  height: 50rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
