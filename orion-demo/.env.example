# MySQL 连接配置（本地调试用外网地址；云托管部署时用内网）
# 把这个文件复制为 .env，填入你自己的密码
# 命令：cp .env.example .env

# 本地调试模式：连外网地址
DB_HOST=sh-cynosdbmysql-grp-qwea7ore.sql.tencentcdb.com
DB_PORT=21814
DB_USER=root
DB_PASSWORD=填你设的 root 密码
DB_NAME=orion

# 微信小程序配置（真实 AppSecret 只写入本地 .env 或云托管环境变量）
WECHAT_MINIPROGRAM_APP_ID=填你的小程序 AppID
WECHAT_MINIPROGRAM_APP_SECRET=填你的小程序 AppSecret
WECHAT_MINIPROGRAM_UPLOAD_PRIVATE_KEY_PATH=.secrets/private.<AppID>.key
WECHAT_MINIPROGRAM_CLOUD_ENV=prod-d5gtkxdyu7263e95b
WECHAT_MINIPROGRAM_CLOUD_SERVICE=express-knlw
WECHAT_MINIPROGRAM_RESOURCE_APPID=wx7dce60930ee10898

# 部署到云托管时改用内网（更快、免外网带宽费）：
# DB_HOST=10.23.110.195
# DB_PORT=3306
# 通过云托管的"环境变量"功能注入，不需要写在这个文件里
