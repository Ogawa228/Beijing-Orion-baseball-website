.contact-page {
  padding-top: 20rpx;
}

.contact-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 184rpx;
}

.hero-logo {
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 104rpx;
  border: 2rpx solid rgba(228, 199, 122, .55);
  border-radius: 50%;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-row {
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 14rpx;
  min-height: 78rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.info-row:last-child {
  border-bottom: 0;
}

.info-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(228, 199, 122, .14);
  font-size: 26rpx;
}

.info-main {
  min-width: 0;
}

.info-label {
  color: #9aa9c4;
  font-size: 22rpx;
  font-weight: 800;
}

.info-value {
  margin-top: 4rpx;
  color: #f6f8ff;
  font-size: 28rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.copy-hint {
  color: #8fb0ff;
  font-size: 22rpx;
  font-weight: 800;
}

.contact-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.contact-row:last-of-type {
  border-bottom: 0;
}

.contact-avatar {
  flex: 0 0 84rpx;
  width: 84rpx;
  height: 84rpx;
  border: 2rpx solid rgba(228, 199, 122, .42);
  border-radius: 50%;
  background: #0f1e38;
}

.contact-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #081120;
  background: #c9a961;
  font-size: 34rpx;
  font-weight: 900;
}

.contact-main {
  flex: 1;
  min-width: 0;
}

.contact-name {
  color: #f6f8ff;
  font-size: 28rpx;
  font-weight: 800;
}

.handle-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.handle-chip {
  width: auto;
  min-height: 48rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid rgba(143, 176, 255, .28);
  border-radius: 999rpx;
  background: rgba(143, 176, 255, .08);
  color: #dbe5f8;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.contact-tip {
  color: #aeb9d0;
  font-size: 24rpx;
  line-height: 1.55;
}

.action-row {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  min-width: 0;
}

.legal-link {
  align-self: flex-start;
  min-height: 52rpx;
  padding: 0;
  color: #8fb0ff;
  font-size: 23rpx;
  font-weight: 800;
  text-align: left;
  line-height: 1.4;
}
