<view class="page admin-page">
  <view class="card panel stack">
    <view>
      <view class="eyebrow">🛠 管理</view>
      <view class="title">猎户管理台</view>
      <view class="subtle">{{user ? user.displayName : '请先登录管理员账号'}}</view>
    </view>
    <view wx:if="{{isAdmin}}" class="permission-track">
      <text wx:for="{{permissionChips}}" wx:key="*this" class="pill">{{item}}</text>
    </view>
  </view>

  <view wx:if="{{!isAdmin && !loading}}" class="section card panel stack">
    <view class="card-title">暂无管理权限</view>
    <view class="subtle">小程序管理台只对 A/B 管理员、数据组或运营组开放。普通队员请使用个人面板。</view>
    <button class="btn btn-primary" bindtap="go" data-url="/pages/profile/profile">返回个人面板</button>
  </view>

  <view wx:if="{{isAdmin}}" class="section card panel stack">
    <view>
      <view class="eyebrow">📋 待办摘要</view>
      <view class="card-title">需要处理的事项</view>
      <view class="subtle">待审绑定、待审时刻、近期接龙、未关联比赛</view>
    </view>
    <view class="stats-grid">
      <view wx:for="{{stats}}" wx:key="label" class="stat-card" bindtap="openTodo" data-kind="{{item.kind}}">
        <view class="stat-value">{{item.value}}</view>
        <view class="subtle">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{isAdmin}}" class="admin-tool-nav section">
    <scroll-view scroll-x class="admin-tool-scroll">
      <view class="admin-tool-track">
        <button
          wx:for="{{adminToolTabs}}"
          wx:key="key"
          class="admin-tool-tab {{activeTool === item.key ? 'active' : ''}}"
          bindtap="switchTool"
          data-tool="{{item.key}}"
        >{{item.label}}</button>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{isAdmin && canWritePlayers && activeTool === 'players'}}" class="section card panel stack player-merge-panel">
    <view>
      <view class="eyebrow">👥 球员</view>
      <view class="card-title">球员档案管理</view>
      <view class="subtle">新增试训/正式球员，或处理重复档案和历史姓名归并。</view>
      <view class="subtle">球员池 / 新增球员 / 批量导入 / 合并档案</view>
    </view>
    <view class="player-panel-tabs">
      <button
        wx:for="{{playerPanelTabs}}"
        wx:key="key"
        class="player-panel-tab {{activePlayerPanel === item.key ? 'active' : ''}}"
        bindtap="switchPlayerPanel"
        data-panel="{{item.key}}"
      >{{item.label}}</button>
    </view>
    <view wx:if="{{activePlayerPanel === 'pool'}}" class="account-action-box player-pool-box">
      <view class="row between">
        <view>
          <view class="card-title compact-title">注册球员池</view>
          <view class="subtle">{{playerPoolSummary}}</view>
        </view>
      </view>
      <view class="player-pool-tools">
        <input class="input compact-input" placeholder="搜索姓名、别名、背号、守位" value="{{playerPoolSearch}}" bindinput="onPlayerPoolSearchInput" />
        <picker mode="selector" range="{{playerPoolLevelOptions}}" range-key="label" value="{{playerPoolLevelIndex}}" bindchange="onPlayerPoolLevelChange">
          <view class="picker-like compact-picker">{{playerPoolLevelLabel}}</view>
        </picker>
      </view>
      <scroll-view scroll-y class="player-pool-list">
        <view wx:for="{{visiblePlayerPool}}" wx:key="id" class="player-pool-row">
          <view class="player-pool-main">
            <view class="player-pool-title">
              <text class="player-pool-number">{{item.numberText}}</text>
              <text>{{item.name}}</text>
            </view>
            <view class="subtle">{{item.positionText}} · {{item.meta}}</view>
            <view class="player-pool-tags">
              <text class="player-level-tag {{item.levelClass}}">{{item.levelLabel}}</text>
            </view>
          </view>
          <view class="player-pool-actions">
            <button class="link tiny-link" data-id="{{item.id}}" bindtap="openPoolPlayer">档案</button>
            <button class="link tiny-link" data-id="{{item.id}}" bindtap="selectPoolPlayerRecords">积分</button>
            <button class="link tiny-link" data-id="{{item.id}}" bindtap="openPoolHighlights">时刻</button>
            <button class="link tiny-link" data-id="{{item.id}}" bindtap="selectPoolMergeSource">合并</button>
            <button wx:if="{{item.canUpgrade}}" class="link tiny-link primary-link" data-id="{{item.id}}" bindtap="upgradePoolPlayer">升级</button>
          </view>
        </view>
        <view wx:if="{{!visiblePlayerPool.length}}" class="empty compact-empty">暂无匹配球员</view>
      </scroll-view>
      <button wx:if="{{playersHasMore}}" class="link load-more-games inline-load-more" loading="{{loadingMorePlayers}}" bindtap="loadMoreAdminPlayers">加载更多球员</button>
    </view>
    <view wx:if="{{activePlayerPanel === 'create'}}" class="account-action-box player-create-box">
      <view class="card-title compact-title">新增球员</view>
      <view class="two-col">
        <picker mode="selector" range="{{playerCreateLevelOptions}}" range-key="label" value="{{createPlayerLevelIndex}}" bindchange="onCreatePlayerLevelChange">
          <view class="picker-like compact-picker">{{createPlayerLevelLabel}}</view>
        </picker>
        <input class="input" placeholder="姓名" value="{{createPlayerName}}" bindinput="onCreatePlayerNameInput" />
      </view>
      <view class="two-col">
        <input class="input" placeholder="背号" value="{{createPlayerNumber}}" bindinput="onCreatePlayerNumberInput" />
        <input class="input" placeholder="守位，例如 CF / P" value="{{createPlayerPosition}}" bindinput="onCreatePlayerPositionInput" />
      </view>
      <view class="two-col">
        <input class="input" placeholder="打席 R / L / S" value="{{createPlayerBats}}" bindinput="onCreatePlayerBatsInput" />
        <input class="input" placeholder="投球 R / L" value="{{createPlayerThrows}}" bindinput="onCreatePlayerThrowsInput" />
      </view>
      <input class="input" type="number" placeholder="入队年份，可选" value="{{createPlayerJoinYear}}" bindinput="onCreatePlayerJoinYearInput" />
      <textarea class="textarea compact" maxlength="24" placeholder="口号，可选" value="{{createPlayerSlogan}}" bindinput="onCreatePlayerSloganInput" />
      <textarea class="textarea compact" placeholder="荣誉标签，用顿号或逗号分隔" value="{{createPlayerTitles}}" bindinput="onCreatePlayerTitlesInput" />
      <textarea class="textarea compact" placeholder="别名，用顿号或逗号分隔，用于历史比赛匹配" value="{{createPlayerAliases}}" bindinput="onCreatePlayerAliasesInput" />
      <view class="create-player-photo-box">
        <view class="create-player-photo-head">
          <text>📸 真实球员照片</text>
          <text class="subtle mini-subtle">上传后自动写入档案</text>
        </view>
        <image wx:if="{{createPlayerPhoto}}" class="create-player-photo-preview" src="{{createPlayerPhoto}}" mode="aspectFill" lazy-load="true" />
        <input class="input" placeholder="图片 URL，可粘贴或上传" value="{{createPlayerPhoto}}" bindinput="onCreatePlayerPhotoInput" />
        <view class="create-photo-actions">
          <button class="btn btn-ghost small-btn" loading="{{uploadingCreatePlayerPhoto}}" bindtap="chooseCreatePlayerPhoto">上传照片</button>
          <button class="btn btn-ghost small-btn" bindtap="clearCreatePlayerPhoto">清空照片</button>
        </view>
        <view wx:if="{{createPlayerPhotoUploadText}}" class="subtle">{{createPlayerPhotoUploadText}}</view>
      </view>
      <view wx:if="{{createPlayerResultText}}" class="invite-code">{{createPlayerResultText}}</view>
      <button class="btn btn-primary" loading="{{saving}}" bindtap="createPlayer">新增球员</button>
    </view>
    <view wx:if="{{activePlayerPanel === 'batch'}}" class="account-action-box player-batch-box">
      <view class="card-title compact-title">批量粘贴导入</view>
      <view class="subtle">每行一个球员：姓名,球衣号,守位；也可继续补打席、投球、入队年份、别名。</view>
      <picker mode="selector" range="{{playerCreateLevelOptions}}" range-key="label" value="{{batchPlayerLevelIndex}}" bindchange="onBatchPlayerLevelChange">
        <view class="picker-like compact-picker">{{batchPlayerLevelLabel}}</view>
      </picker>
      <textarea class="textarea batch-player-text" placeholder="例如：&#10;张三,15,2B&#10;李四,22,OF,R,R,2026,小李、Li" value="{{batchPlayerText}}" bindinput="onBatchPlayerTextInput" />
      <view class="batch-photo-box">
        <view class="batch-photo-head">
          <text>🖼 批量照片匹配</text>
          <text class="subtle mini-subtle">{{batchPlayerPhotoCount}} 张</text>
        </view>
        <view class="subtle">照片文件名写球员姓名，例如“张三.jpg”，导入时会自动匹配到同名球员档案。</view>
        <view class="create-photo-actions">
          <button class="btn btn-ghost small-btn" loading="{{uploadingBatchPlayerPhotos}}" bindtap="chooseBatchPlayerPhotos">选择照片</button>
          <button class="btn btn-ghost small-btn" bindtap="clearBatchPlayerPhotos">清空照片</button>
        </view>
        <view wx:if="{{batchPlayerPhotoText}}" class="subtle">{{batchPlayerPhotoText}}</view>
      </view>
      <view wx:if="{{batchPlayerResultText}}" class="invite-code">{{batchPlayerResultText}}</view>
      <button class="btn btn-ghost" loading="{{saving}}" bindtap="importPlayersBatch">导入名单</button>
    </view>
    <view wx:if="{{activePlayerPanel === 'merge'}}" class="account-action-box player-merge-box">
      <view>
        <view class="card-title compact-title">合并球员档案</view>
        <view class="subtle">用于试训转正式、重复档案或 PDF/比赛记录姓名归并。</view>
      </view>
      <picker mode="selector" range="{{mergeSourceOptions}}" range-key="label" value="{{mergeSourceIndex}}" bindchange="onMergeSourceChange">
        <view class="picker-like">{{mergeSourceLabel}}</view>
      </picker>
      <picker mode="selector" range="{{mergeTargetOptions}}" range-key="label" value="{{mergeTargetIndex}}" bindchange="onMergeTargetChange">
        <view class="picker-like">{{mergeTargetLabel}}</view>
      </picker>
      <checkbox-group class="merge-options" bindchange="onMergeKeepAliasChange">
        <label class="admin-group-option merge-option">
          <checkbox value="keep" checked="{{mergeKeepAliasValues.length > 0}}" />
          <text>保留源姓名和别名用于历史统计归并</text>
        </label>
      </checkbox-group>
      <view class="merge-preview">{{mergePreviewText}}</view>
      <view wx:if="{{mergeResultText}}" class="invite-code">{{mergeResultText}}</view>
      <button class="btn btn-primary" loading="{{saving}}" bindtap="mergePlayers">确认合并</button>
    </view>
  </view>

  <view wx:if="{{isAdmin && (canManageUsers || canResetPassword) && activeTool === 'accounts'}}" class="section card panel stack">
    <view>
      <view class="eyebrow">👤 权限</view>
      <view class="card-title">账号管理</view>
      <view class="subtle">A 级可调整后台等级和重置网页密码；球员绑定统一走申请审批。</view>
    </view>
    <view class="admin-user-filters">
      <input class="input admin-user-search" placeholder="搜索昵称、邮箱、球员、号码" value="{{adminUserSearch}}" bindinput="onAdminUserSearchInput" />
      <picker mode="selector" range="{{adminIdentityFilterOptions}}" range-key="label" value="{{adminIdentityFilterIndex}}" bindchange="onAdminIdentityFilterChange">
        <view class="picker-like compact-picker">{{adminIdentityFilterLabel}}</view>
      </picker>
      <picker mode="selector" range="{{adminGroupFilterOptions}}" range-key="label" value="{{adminGroupFilterIndex}}" bindchange="onAdminGroupFilterChange">
        <view class="picker-like compact-picker">{{adminGroupFilterLabel}}</view>
      </picker>
      <picker class="admin-position-filter" mode="selector" range="{{adminPositionFilterOptions}}" range-key="label" value="{{adminPositionFilterIndex}}" bindchange="onAdminPositionFilterChange">
        <view class="picker-like compact-picker">{{adminPositionFilterLabel}}</view>
      </picker>
      <picker class="admin-bind-filter" mode="selector" range="{{adminBindFilterOptions}}" range-key="label" value="{{adminBindFilterIndex}}" bindchange="onAdminBindFilterChange">
        <view class="picker-like compact-picker">{{adminBindFilterLabel}}</view>
      </picker>
      <picker class="admin-sort-filter" mode="selector" range="{{adminUserSortOptions}}" range-key="label" value="{{adminUserSortIndex}}" bindchange="onAdminUserSortChange">
        <view class="picker-like compact-picker">{{adminUserSortLabel}}</view>
      </picker>
    </view>
    <view class="subtle">筛选结果：{{adminUserFilterSummary}}</view>
    <button wx:if="{{adminUsersHasMore}}" class="btn btn-ghost small-btn" loading="{{loadingMoreAdminUsers}}" bindtap="loadMoreAdminUsers">加载更多账号</button>
    <picker mode="selector" range="{{adminUserOptions}}" range-key="label" value="{{adminUserIndex}}" bindchange="onAdminUserChange">
      <view class="picker-like">{{adminUserLabel}}</view>
    </picker>
    <view wx:if="{{adminUserMeta}}" class="subtle">{{adminUserMeta}}</view>
    <view wx:if="{{canManageUsers}}" class="stack">
      <picker mode="selector" range="{{adminLevelOptions}}" range-key="label" value="{{adminLevelIndex}}" bindchange="onAdminLevelChange">
        <view class="picker-like">{{adminLevelLabel}}</view>
      </picker>
      <checkbox-group class="admin-group-list" bindchange="onAdminGroupChange">
        <label wx:for="{{adminGroupOptions}}" wx:key="value" class="admin-group-option">
          <checkbox value="{{item.value}}" checked="{{item.checked}}" />
          <text>{{item.label}}</text>
        </label>
      </checkbox-group>
      <button class="btn btn-primary" loading="{{saving}}" bindtap="saveAdminPermission">保存权限</button>
    </view>
    <view wx:if="{{canResetPassword}}" class="account-action-box">
      <input class="input" password="{{true}}" placeholder="新网页密码，至少 6 位" value="{{resetPasswordValue}}" bindinput="onResetPasswordInput" />
      <button class="btn btn-ghost" loading="{{saving}}" bindtap="resetAdminPassword">重置网页密码</button>
      <view class="subtle">只影响邮箱网页登录；不能在这里重置当前登录账号自己的密码。</view>
    </view>
  </view>

  <view wx:if="{{isAdmin && activeTool === 'reviews'}}" class="section card panel stack">
    <view class="row between">
      <view>
        <view class="eyebrow">✅ 审批</view>
        <view class="card-title">绑定审批</view>
      </view>
      <button class="link" bindtap="load">刷新</button>
    </view>
    <picker mode="selector" range="{{bindRequestStatusOptions}}" range-key="label" value="{{bindRequestStatusIndex}}" bindchange="onBindRequestStatusChange">
      <view class="picker-like compact-picker">{{bindRequestStatusLabel}}</view>
    </picker>
    <textarea class="textarea compact" placeholder="审批备注，可选" value="{{reviewNote}}" bindinput="onReviewNoteInput" />
    <view wx:for="{{pendingRequests}}" wx:key="id" class="request-card">
      <view>
        <view class="request-title-row">
          <view class="request-title">{{item.applicant}}</view>
          <view class="request-status {{item.statusClass}}">{{item.statusLabel}}</view>
        </view>
        <view class="subtle">申请绑定：{{item.target}}</view>
        <view wx:if="{{item.meta}}" class="subtle">{{item.meta}}</view>
        <view wx:if="{{item.note}}" class="note">{{item.note}}</view>
      </view>
      <view wx:if="{{item.isPending}}" class="request-actions">
        <button class="btn btn-primary small-btn" loading="{{saving}}" bindtap="approveRequest" data-id="{{item.id}}">批准</button>
        <button class="btn btn-danger small-btn" loading="{{saving}}" bindtap="rejectRequest" data-id="{{item.id}}">驳回</button>
      </view>
    </view>
    <view wx:if="{{!pendingRequests.length}}" class="empty">{{bindRequestEmptyText}}</view>
  </view>

  <view wx:if="{{isAdmin && (canWritePoints || canWriteAttendances) && activeTool === 'points'}}" class="section card panel stack points-panel">
    <view>
      <view class="eyebrow">🧾 操作</view>
      <view class="card-title">积分与签到</view>
      <view class="subtle">查看全员积分总览，补录后可查看选中球员的近期记录；录错时从这里撤销，后端会写审计。</view>
    </view>
    <view wx:if="{{canViewPointsOverview}}" class="account-action-box points-overview-box">
      <view class="row between">
        <view class="card-title compact-title">全员积分总览</view>
        <button class="link" bindtap="go" data-url="/pages/points/points">详情</button>
      </view>
      <view wx:for="{{leaderboardOverview}}" wx:key="playerId" class="leaderboard-overview-row {{item.rankClass}}" bindtap="openLeaderboardPlayer" data-id="{{item.playerId}}">
        <view class="overview-rank">{{item.rank}}</view>
        <view class="overview-main">
          <view class="overview-name">{{item.displayName}}</view>
          <view class="subtle">{{item.meta}}</view>
          <view class="subtle">{{item.breakdownText}}</view>
        </view>
        <view class="overview-total">{{item.total}}</view>
      </view>
      <view wx:if="{{!leaderboardOverview.length}}" class="empty compact-empty">暂无积分记录</view>
    </view>
    <picker mode="selector" range="{{playerOptions}}" range-key="label" value="{{playerIndex}}" bindchange="onPlayerChange">
      <view class="picker-like">{{playerLabel}}</view>
    </picker>
    <button wx:if="{{playersHasMore}}" class="link load-more-games inline-load-more" loading="{{loadingMorePlayers}}" bindtap="loadMoreAdminPlayers">加载更多球员候选</button>
    <view wx:if="{{canWritePoints}}" class="account-action-box score-action-box">
      <view class="card-title compact-title">手动积分调整</view>
      <view class="two-col">
        <input class="input" type="number" placeholder="积分，例如 5 或 -3" value="{{pointDelta}}" bindinput="onPointDeltaInput" />
        <input class="input" placeholder="原因" value="{{pointReason}}" bindinput="onPointReasonInput" />
      </view>
      <view class="point-game-selector">
        <view class="row between">
          <view>
            <view class="subtle">关联比赛（可选）</view>
            <view class="point-game-label">{{pointGameLabel}}</view>
            <view class="subtle">{{pointGameMeta}}</view>
          </view>
          <button class="link" bindtap="clearPointGame">清除</button>
        </view>
        <view class="point-game-tools">
          <input class="input compact-input" placeholder="搜索对手、日期、赛事、场地" value="{{pointGameSearch}}" bindinput="onPointGameSearchInput" />
          <picker mode="selector" range="{{pointGameOptions}}" range-key="label" value="{{pointGameIndex}}" bindchange="onPointGameChange">
            <view class="picker-like compact-picker">选择比赛</view>
          </picker>
        </view>
        <button wx:if="{{gamesHasMore}}" class="link load-more-games inline-load-more" loading="{{loadingMoreGames}}" bindtap="loadMoreAdminGames">加载更多比赛候选</button>
      </view>
      <button class="btn btn-ghost" loading="{{saving}}" bindtap="submitPointAdjustment">手动调整积分</button>
      <view class="history-list">
        <view wx:for="{{pointAdjustments}}" wx:key="id" class="history-row">
          <view class="history-main">
            <view class="history-title"><text class="score-delta {{item.deltaClass}}">{{item.deltaText}}</text><text>{{item.reasonText}}</text></view>
            <view class="subtle">{{item.meta}}</view>
          </view>
          <button class="link tiny-link danger-link" data-id="{{item.id}}" bindtap="deletePointAdjustment">删除</button>
        </view>
        <view wx:if="{{!pointAdjustments.length}}" class="empty compact-empty">暂无手动积分记录</view>
      </view>
    </view>

	    <view wx:if="{{canWriteAttendances}}" class="account-action-box score-action-box">
	      <view class="card-title compact-title">补录签到</view>
	      <picker mode="selector" range="{{attendanceKinds}}" range-key="label" value="{{attendanceKindIndex}}" bindchange="onAttendanceKindChange">
	        <view class="picker-like">{{attendanceKindLabel}}</view>
      </picker>
	      <picker mode="date" value="{{attendanceDate}}" bindchange="onAttendanceDateChange">
	        <view class="picker-like">{{attendanceDate}}</view>
	      </picker>
	      <input class="input" placeholder="备注，例如补录训练 / 比赛到场" value="{{attendanceNote}}" bindinput="onAttendanceNoteInput" />
	      <view class="attendance-batch-box">
	        <view class="row between">
	          <view>
	            <view class="card-title compact-title">批量出席名单</view>
	            <view class="subtle">{{attendanceSelectionSummary}}</view>
	          </view>
	          <button class="link" bindtap="clearAttendancePlayers">清空</button>
	        </view>
	        <view class="attendance-batch-tools">
	          <input class="input compact-input" placeholder="搜索球员、背号、守位" value="{{attendancePlayerSearch}}" bindinput="onAttendancePlayerSearchInput" />
	          <button class="link" bindtap="selectAllAttendancePlayers">全选当前</button>
	        </view>
	        <checkbox-group class="attendance-player-list" bindchange="onAttendancePlayerSelectionChange">
	          <label wx:for="{{visibleAttendancePlayers}}" wx:key="id" class="attendance-player-row">
	            <checkbox value="{{item.id}}" checked="{{item.selected}}" />
	            <view class="attendance-player-main">
	              <view class="attendance-player-title">
	                <text class="player-pool-number">{{item.numberText}}</text>
	                <text>{{item.name}}</text>
	                <text class="player-level-tag {{item.levelClass}}">{{item.levelLabel}}</text>
	              </view>
	              <view class="subtle">{{item.meta}}</view>
	            </view>
	          </label>
	        </checkbox-group>
	        <view wx:if="{{!visibleAttendancePlayers.length}}" class="empty compact-empty">暂无匹配球员</view>
	      </view>
	      <button class="btn btn-primary" loading="{{saving}}" bindtap="submitAttendance">{{attendanceSubmitLabel}}</button>
	      <view class="history-list">
        <view wx:for="{{attendanceRecords}}" wx:key="id" class="history-row">
          <view class="history-main">
            <view class="history-title"><text>{{item.kindLabel}}</text><text> · {{item.dateText}}</text></view>
            <view class="subtle">{{item.noteText}}</view>
            <view wx:if="{{item.meta}}" class="subtle">{{item.meta}}</view>
          </view>
          <button class="link tiny-link danger-link" data-id="{{item.id}}" bindtap="deleteAttendanceRecord">删除</button>
        </view>
        <view wx:if="{{!attendanceRecords.length}}" class="empty compact-empty">暂无签到记录</view>
      </view>
    </view>
  </view>

  <view wx:if="{{isAdmin && canReadAudit && activeTool === 'audit'}}" class="section card panel stack">
    <view class="row between">
      <view>
        <view class="eyebrow">🧭 审计</view>
        <view class="card-title">最近操作</view>
      </view>
      <view class="audit-actions">
        <button class="link" bindtap="go" data-url="/pages/admin/audit/audit">详情</button>
        <button class="link" bindtap="load">刷新</button>
      </view>
    </view>
    <view wx:for="{{auditLogs}}" wx:key="id" class="audit-row">
      <view class="audit-title">{{item.title}}</view>
      <view class="subtle">{{item.actorText}}</view>
      <view class="subtle">{{item.meta}}</view>
      <view wx:if="{{item.timeText}}" class="audit-time">{{item.timeText}}</view>
    </view>
    <view wx:if="{{!auditLogs.length}}" class="empty compact-empty">暂无审计记录</view>
  </view>

  <view wx:if="{{isAdmin}}" class="section card panel stack">
    <view>
      <view class="eyebrow">⚡ 快捷</view>
      <view class="card-title">常用入口</view>
    </view>
    <view class="shortcut-grid">
