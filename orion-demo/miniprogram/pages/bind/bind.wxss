.bind-hero,
.form-card {
  border-color: rgba(228, 199, 122, .36);
  background:
    linear-gradient(135deg, rgba(228, 199, 122, .14), rgba(143, 176, 255, .08)),
    rgba(10, 22, 40, .88);
}

.steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.step {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  border: 1rpx solid rgba(228, 199, 122, .24);
  border-radius: 12rpx;
  color: #e4c77a;
  background: rgba(201, 169, 97, .08);
  font-size: 22rpx;
  font-weight: 800;
}

.card-title {
  color: #f6f8ff;
  font-size: 30rpx;
  font-weight: 760;
}

.player-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.player-row.active {
  padding-left: 14rpx;
  border-radius: 14rpx;
  background: rgba(201, 169, 97, .12);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-input {
  min-width: 0;
  flex: 1 1 auto;
}

.search-btn {
  flex: 0 0 150rpx;
  min-height: 72rpx;
  padding: 0 14rpx;
  font-size: 24rpx;
}

.load-more {
  min-height: 72rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
}

.submit-btn {
  min-height: 86rpx;
  font-size: 28rpx;
}

.compact-empty {
  min-height: 96rpx;
  padding: 24rpx;
}

.selected-card {
  border-color: rgba(201, 169, 97, .34);
  background: linear-gradient(135deg, rgba(201, 169, 97, .13), rgba(46, 107, 255, .08));
}

.selected-main {
  margin-top: 6rpx;
  color: #f6f8ff;
  font-size: 32rpx;
  font-weight: 900;
}

.status-card {
  border-color: rgba(91, 139, 255, .28);
}

.status-title {
  color: #f6f8ff;
  font-size: 30rpx;
  font-weight: 900;
}

.status-pill {
  flex: 0 0 auto;
  min-width: 88rpx;
  padding: 8rpx 12rpx;
  border: 1rpx solid rgba(228, 199, 122, .42);
  border-radius: 999rpx;
  color: #e4c77a;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.status-pill.approved {
  border-color: rgba(111, 220, 160, .42);
  color: #9af1bd;
}

.status-pill.rejected {
  border-color: rgba(255, 138, 138, .35);
  color: #ffb4b4;
}

.name {
  color: #f6f8ff;
  font-size: 28rpx;
  font-weight: 800;
}
