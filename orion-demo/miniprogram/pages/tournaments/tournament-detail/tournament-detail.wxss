.tournament-detail-page {
  padding-top: 20rpx;
}

.tournament-hero {
  position: relative;
  min-height: 360rpx;
  overflow: hidden;
  padding: 0;
}

.hero-cover,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-shade {
  background: linear-gradient(180deg, rgba(5, 11, 24, .16), rgba(5, 11, 24, .92));
}

.hero-content {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 360rpx;
  padding: 30rpx;
}

.hero-title {
  margin-top: 10rpx;
  color: #f6f8ff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
}

.hero-meta {
  margin-top: 12rpx;
  color: #e4c77a;
  font-size: 25rpx;
  font-weight: 850;
}

.hero-sub,
.hero-desc {
  margin-top: 10rpx;
  color: #b8c4dc;
  font-size: 24rpx;
  line-height: 1.45;
}

.hero-desc {
  color: #d8e0f0;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.metric {
  min-width: 0;
  padding: 18rpx;
}

.metric-value {
  color: #f6f8ff;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
}

.compact-head {
  margin-bottom: 14rpx;
}

.sort-picker {
  flex: 0 0 auto;
  min-width: 120rpx;
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(155, 188, 255, .28);
  border-radius: 999rpx;
  color: #9bbcff;
  font-size: 23rpx;
  font-weight: 850;
  text-align: center;
}

.game-row {
  display: grid;
  grid-template-columns: 126rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.game-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 88rpx;
  overflow: hidden;
  border: 1rpx solid rgba(228, 199, 122, .18);
  border-radius: 8rpx;
  background: rgba(228, 199, 122, .08);
}

.game-cover.no-cover {
  background: linear-gradient(135deg, rgba(15, 39, 78, .88), rgba(4, 13, 27, .95));
}

.game-cover-img {
  width: 100%;
  height: 100%;
}

.game-cover-fallback {
  color: #e4c77a;
  font-size: 22rpx;
  font-weight: 900;
}

.game-main {
  min-width: 0;
}

.game-title {
  color: #f6f8ff;
  font-size: 27rpx;
  font-weight: 850;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-score {
  color: #e4c77a;
  font-size: 30rpx;
  font-weight: 900;
  white-space: nowrap;
}

.leader-row {
  display: grid;
  grid-template-columns: 46rpx minmax(0, 1fr) 92rpx;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.leader-row.is-link {
  border-color: rgba(155, 188, 255, .2);
}

.rank {
  color: #e4c77a;
  font-size: 30rpx;
  font-weight: 900;
  text-align: center;
}

.leader-main {
  min-width: 0;
}

.leader-name {
  color: #f6f8ff;
  font-size: 29rpx;
  font-weight: 880;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.leader-stats {
  text-align: right;
}

.ops {
  color: #e4c77a;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
}
