.import-page .card-title {
  color: #f6f8ff;
  font-size: 30rpx;
  font-weight: 800;
}

.file-box {
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, .1);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, .04);
}

.file-name {
  color: #f6f8ff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.tournament-more {
  min-height: 68rpx;
  border-radius: 22rpx;
}

.queue-list {
  display: grid;
  gap: 10rpx;
}

.queue-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 88rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .08);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .035);
}

.queue-row.active {
  border-color: rgba(155, 188, 255, .56);
  background: rgba(155, 188, 255, .09);
}

.queue-row.saved {
  border-color: rgba(117, 211, 142, .35);
  background: rgba(117, 211, 142, .06);
}

.queue-row.parsed {
  border-color: rgba(228, 199, 122, .42);
}

.queue-main {
  flex: 1;
  min-width: 0;
}

.queue-name {
  color: #f6f8ff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.queue-status {
  flex: 0 0 auto;
  min-width: 86rpx;
  color: #e4c77a;
  font-size: 22rpx;
  font-weight: 900;
  text-align: right;
}

.cover-box {
  display: grid;
  grid-template-columns: 128rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: center;
  padding: 16rpx;
  border: 1rpx solid rgba(228, 199, 122, .2);
  border-radius: 12rpx;
  background: rgba(228, 199, 122, .055);
}

.cover-preview {
  width: 128rpx;
  height: 88rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .08);
}

.cover-info {
  min-width: 0;
}

.cover-title {
  color: #f6f8ff;
  font-size: 25rpx;
  font-weight: 800;
}

.cover-status {
  margin-top: 6rpx;
  color: #e4c77a;
  font-size: 22rpx;
  font-weight: 800;
}

.cover-btn {
  grid-column: 1 / -1;
  min-height: 68rpx;
  border-radius: 22rpx;
}

.score-line {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  color: #f6f8ff;
  font-size: 27rpx;
  font-weight: 800;
  text-align: center;
}

.score {
  color: #e4c77a;
  font-size: 38rpx;
  font-weight: 900;
  white-space: nowrap;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.summary-cell {
  min-height: 104rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .08);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, .04);
}

.summary-value {
  margin-top: 8rpx;
  color: #f6f8ff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.warning-box {
  padding: 18rpx;
  border: 1rpx solid rgba(228, 199, 122, .28);
  border-radius: 14rpx;
  background: rgba(228, 199, 122, .08);
}

.warning-title {
  margin-bottom: 8rpx;
  color: #e4c77a;
  font-size: 25rpx;
  font-weight: 900;
}

.warning-item {
  color: #f2d998;
  font-size: 23rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.preview-block {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .08);
}

.preview-title {
  color: #f6f8ff;
  font-size: 27rpx;
  font-weight: 800;
}

.preview-row {
  display: grid;
  grid-template-columns: minmax(0, 160rpx) minmax(0, 1fr);
  gap: 12rpx;
  color: #dbe5f8;
  font-size: 24rpx;
  line-height: 1.45;
}
