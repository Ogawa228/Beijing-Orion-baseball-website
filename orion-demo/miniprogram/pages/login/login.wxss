.login-hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.login-logo {
  width: 128rpx;
  height: 128rpx;
  border: 2rpx solid rgba(228, 199, 122, .6);
  border-radius: 50%;
}

.field-label {
  margin-bottom: 12rpx;
  color: #e8eefa;
  font-size: 26rpx;
  font-weight: 700;
}

.tip {
  margin-top: 10rpx;
}

.legal-card {
  padding: 20rpx;
  border: 1rpx solid rgba(228, 199, 122, .24);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .04);
}

.legal-title {
  color: #f6f8ff;
  font-size: 28rpx;
  font-weight: 800;
}

.legal-link {
  display: inline;
  color: #8fb0ff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
  text-decoration: underline;
}

.legal-link-hover {
  color: #e4c77a;
}

.consent-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.consent-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: #dbe5f8;
  font-size: 24rpx;
  line-height: 1.5;
}
