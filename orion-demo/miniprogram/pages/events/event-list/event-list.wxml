<view class="page">
  <view class="section-head event-list-head">
    <view>
      <view class="eyebrow">📌 接龙</view>
      <view class="title">活动接龙</view>
    </view>
    <view class="head-actions">
      <button wx:if="{{canCreateEvent}}" class="btn btn-primary action-btn" bindtap="create">发起</button>
      <button class="btn btn-ghost action-btn" bindtap="load">刷新</button>
    </view>
  </view>

  <view wx:if="{{loading && !events.length}}" class="card panel skeleton-group">
    <view class="skeleton-line tall"></view>
    <view class="skeleton-line"></view>
    <view class="skeleton-line short"></view>
  </view>

  <view wx:for="{{events}}" wx:key="id" class="event-card card panel" bindtap="open" data-id="{{item.id}}">
    <image wx:if="{{item.previewCover}}" class="event-cover" mode="aspectFill" lazy-load="{{true}}" src="{{item.previewCover}}" />
    <view class="row between">
      <view class="pill">{{item.tagLabel || '📅 活动'}}</view>
      <view class="signup-count">{{item.signupCount}} 人</view>
    </view>
    <view class="card-title">{{item.title}}</view>
    <view class="subtle">{{item.date}} · {{item.location}}</view>
    <view class="subtle body">{{item.body}}</view>
  </view>

  <button wx:if="{{hasMore}}" class="btn btn-ghost load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">加载更多接龙</button>
  <view wx:if="{{!events.length && !loading}}" class="card empty">暂无活动</view>
</view>
