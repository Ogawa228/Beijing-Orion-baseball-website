.label {
  margin-bottom: 10rpx;
  color: #e8eefa;
  font-size: 25rpx;
  font-weight: 700;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.picker-arrow {
  flex: 0 0 auto;
  color: #8fb0ff;
  font-size: 24rpx;
  font-weight: 700;
}

.time-picker-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 124rpx;
  gap: 12rpx;
}

.time-picker-main {
  min-width: 0;
}

.clear-time-btn {
  min-height: 78rpx;
  padding: 0 10rpx;
  border-radius: 22rpx;
  font-size: 23rpx;
}

.location-edit-box {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 176rpx;
  gap: 14rpx;
  align-items: end;
}

.location-edit-main {
  min-width: 0;
}

.location-pick-btn {
  min-height: 78rpx;
  padding: 0 12rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
}

.cover-edit-box {
  display: grid;
  grid-template-columns: 156rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: center;
  padding: 16rpx;
  border: 1rpx solid rgba(228, 199, 122, .2);
  border-radius: 8rpx;
  background: rgba(228, 199, 122, .055);
}

.cover-edit-preview {
  width: 156rpx;
  height: 112rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .08);
}

.cover-edit-main {
  min-width: 0;
}

.cover-input {
  min-height: 68rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
}

.cover-upload-btn {
  grid-column: 1 / -1;
  min-height: 68rpx;
  border-radius: 22rpx;
}

.gallery-edit-box {
  display: grid;
  gap: 16rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(143, 176, 255, .2);
  border-radius: 8rpx;
  background: rgba(143, 176, 255, .045);
}

.gallery-head {
  align-items: flex-start;
  gap: 16rpx;
}

.gallery-upload-btn {
  flex: 0 0 188rpx;
  min-height: 68rpx;
  padding: 0 12rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.gallery-item {
  position: relative;
  min-width: 0;
}

.gallery-image {
  display: block;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .08);
}

.gallery-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  min-width: 68rpx;
  min-height: 36rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(5, 11, 24, .82);
  color: #ffdfdf;
  font-size: 20rpx;
  line-height: 1.2;
  text-align: center;
}

.gallery-remove::after {
  border: 0;
}
