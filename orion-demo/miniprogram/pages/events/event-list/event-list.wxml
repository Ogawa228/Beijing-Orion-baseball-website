<view class="page tab-page event-list-page">
  <view class="section-head event-list-head">
    <view>
      <view class="eyebrow">📌 活动 · ⚾ 比赛</view>
      <view class="title">赛事活动工作台</view>
    </view>
  </view>

  <view class="hub-actions">
    <button wx:if="{{canRecordGame}}" class="hub-action-card primary-card" bindtap="startRecord">
      <text class="hub-action-icon">⚾</text>
      <text class="hub-action-title">开始记录比赛</text>
      <text class="hub-action-sub">现场记分</text>
    </button>
    <button wx:if="{{canManageTournaments}}" class="hub-action-card" bindtap="createTournament">
      <text class="hub-action-icon">🏆</text>
      <text class="hub-action-title">新建赛事</text>
      <text class="hub-action-sub">杯赛 / 联赛容器</text>
    </button>
    <button wx:if="{{canCreateEvent}}" class="hub-action-card" bindtap="create">
      <text class="hub-action-icon">📌</text>
      <text class="hub-action-title">发起活动接龙</text>
      <text class="hub-action-sub">报名与签到</text>
    </button>
  </view>

  <view class="section-tabs card">
    <view
      wx:for="{{sectionTabs}}"
      wx:key="key"
      class="section-tab {{activeSection === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchSection"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{activeSection === 'relay'}}" class="section-head event-section-head">
    <view>
      <view class="eyebrow">📌 接龙</view>
      <view class="title small-title">最近接龙</view>
    </view>
    <button class="mini-link" bindtap="load">刷新</button>
  </view>

  <view wx:if="{{activeSection === 'relay' && loading && !events.length}}" class="card panel skeleton-group">
    <view class="skeleton-line tall"></view>
    <view class="skeleton-line"></view>
    <view class="skeleton-line short"></view>
  </view>

  <view wx:if="{{activeSection === 'relay'}}" wx:for="{{events}}" wx:key="id" class="event-card card panel" bindtap="open" data-id="{{item.id}}">
    <image wx:if="{{item.previewCover}}" class="event-cover" mode="aspectFill" lazy-load="{{true}}" src="{{item.previewCover}}" />
    <view class="row between">
      <view class="pill">{{item.tagLabel || '📅 活动'}}</view>
      <view class="signup-count">{{item.signupCount}} 人</view>
    </view>
    <view class="card-title">{{item.title}}</view>
    <view class="subtle">{{item.date}} · {{item.location}}</view>
    <view class="subtle body">{{item.body}}</view>
  </view>

  <button wx:if="{{activeSection === 'relay' && hasMore}}" class="btn btn-ghost load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">加载更多接龙</button>
  <view wx:if="{{activeSection === 'relay' && !events.length && !loading}}" class="card empty">暂无活动</view>

  <view wx:if="{{activeSection === 'tournament'}}" class="section-head event-section-head recent-game-head">
    <view>
      <view class="eyebrow">🏆 赛事</view>
      <view class="title small-title">赛事容器</view>
    </view>
    <button wx:if="{{canManageTournaments}}" class="mini-link" bindtap="createTournament">新建赛事</button>
  </view>

  <view wx:if="{{activeSection === 'tournament'}}" wx:for="{{tournaments}}" wx:key="id" class="tournament-row card panel">
    <view class="row between tournament-row-head">
      <view>
        <view class="pill">{{item.typeLabel}} · {{item.sportLabel}}</view>
        <view class="card-title tournament-title">{{item.displayName}}</view>
      </view>
      <view class="tournament-count">{{item.countText}}</view>
    </view>
    <view class="subtle">{{item.season || '未设赛季'}} · {{item.dateText}}</view>
    <view class="subtle">{{item.locationText}}</view>
    <view class="tournament-actions">
      <button class="btn btn-ghost small-action" bindtap="openTournament" data-id="{{item.id}}">详情</button>
      <button wx:if="{{canManageTournaments}}" class="btn btn-ghost small-action" bindtap="editTournament" data-id="{{item.id}}">编辑</button>
    </view>
  </view>
  <view wx:if="{{activeSection === 'tournament' && !tournaments.length && !loading}}" class="card empty">
    <view>暂无赛事</view>
    <button wx:if="{{canManageTournaments}}" class="btn btn-primary empty-action" bindtap="createTournament">新建赛事</button>
  </view>

  <view wx:if="{{activeSection === 'game'}}" class="section-head event-section-head recent-game-head">
    <view>
      <view class="eyebrow">⚾ 比赛</view>
      <view class="title small-title">最近比赛</view>
    </view>
    <button class="mini-link" bindtap="openGames">全部比赛</button>
  </view>

  <view wx:if="{{activeSection === 'game'}}" class="game-secondary-actions">
    <button class="btn btn-ghost secondary-action" bindtap="openGames">查看全部比赛</button>
    <button wx:if="{{canImport}}" class="btn btn-ghost secondary-action" bindtap="openImport">数据导入</button>
  </view>

  <view wx:if="{{activeSection === 'game'}}" wx:for="{{recentGames}}" wx:key="id" class="recent-game-row card panel" bindtap="openGame" data-id="{{item.id}}">
    <view>
      <view class="recent-game-title">{{item.title}}</view>
      <view class="subtle">{{item.metaText}}</view>
    </view>
    <view class="recent-game-score">{{item.scoreText}}</view>
  </view>
  <view wx:if="{{activeSection === 'game' && !recentGames.length && !loading}}" class="card empty">暂无比赛，开始记录第一场。</view>
</view>
