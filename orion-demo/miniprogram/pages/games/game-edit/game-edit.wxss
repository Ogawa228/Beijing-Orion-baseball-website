.game-edit-page .card-title {
  color: #f6f8ff;
  font-size: 30rpx;
  font-weight: 820;
}

.two-col {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.score-grid,
.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.score-grid .input,
.stat-grid .input {
  min-height: 78rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
}

.cover-edit-box {
  display: grid;
  grid-template-columns: 148rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: center;
  padding: 16rpx;
  border: 1rpx solid rgba(228, 199, 122, .2);
  border-radius: 8rpx;
  background: rgba(228, 199, 122, .055);
}

.cover-edit-preview {
  width: 148rpx;
  height: 104rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .08);
}

.cover-edit-main {
  min-width: 0;
}

.cover-edit-title {
  margin-bottom: 10rpx;
  color: #f6f8ff;
  font-size: 25rpx;
  font-weight: 850;
}

.cover-input {
  min-height: 68rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
}

.cover-upload-btn {
  grid-column: 1 / -1;
  min-height: 68rpx;
}

.tournament-more {
  min-height: 68rpx;
}

.reason {
  border-color: rgba(228, 199, 122, .38);
}

.danger-zone {
  border-color: rgba(255, 138, 138, .28);
}

.danger-title {
  color: #ffb4b4 !important;
}
