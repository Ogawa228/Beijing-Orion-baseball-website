.live-page {
  padding-bottom: 260rpx;
}

.live-scoreboard,
.scoreboard {
  position: sticky;
  top: 0;
  z-index: 4;
  text-align: left;
  backdrop-filter: blur(18rpx);
}

.live-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.live-meta-item {
  min-width: 0;
  padding: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, .08);
  border-radius: 10rpx;
  background: rgba(255, 255, 255, .04);
}

.live-meta-item.wide {
  grid-column: 1 / -1;
}

.count-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(228, 199, 122, .28);
  border-radius: 12rpx;
  background: rgba(228, 199, 122, .1);
}

.count-value {
  color: #f6f8ff;
  font-size: 38rpx;
  font-weight: 900;
}

.count-value.small {
  flex: 0 0 auto;
  font-size: 30rpx;
}

.count-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 86rpx;
  min-height: 58rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #081120;
  background: #e4c77a;
  font-size: 28rpx;
  font-weight: 900;
}

.rule-strip {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(143, 176, 255, .18);
  border-radius: 10rpx;
  color: #dbe5f8;
  background: rgba(143, 176, 255, .08);
  font-size: 23rpx;
  line-height: 1.45;
}

.score-mode-tabs {
  position: sticky;
  top: 260rpx;
  z-index: 3;
  display: flex;
  gap: 8rpx;
  margin: 18rpx 0 8rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, .1);
  border-radius: 999rpx;
  background: rgba(6, 15, 30, .92);
  overflow-x: auto;
  white-space: nowrap;
}

.score-mode-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 86rpx;
  min-height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #9aa9c4;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.score-mode-tab.active {
  color: #081120;
  background: #e4c77a;
}

.score-mode-panel {
  margin-top: 18rpx;
}

.current-batter-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, .1);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, .045);
}

.batter-name {
  color: #f6f8ff;
  font-size: 34rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
}

.pitch-actions,
.primary-actions,
.more-results {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.pitch-actions .foul {
  grid-column: 1 / -1;
}

.pitch-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 88rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .14);
  border-radius: 24rpx;
  color: #f6f8ff;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  background: rgba(255, 255, 255, .06);
  overflow-wrap: anywhere;
}

.pitch-btn.ball {
  border-color: rgba(143, 176, 255, .36);
  background: rgba(143, 176, 255, .14);
}

.pitch-btn.strike,
.pitch-btn.foul {
  border-color: rgba(228, 199, 122, .42);
  background: rgba(228, 199, 122, .14);
}

.inner-section {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .08);
}

.matchup {
  margin-top: 18rpx;
  color: #f6f8ff;
  font-size: 34rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.big-score {
  margin-top: 14rpx;
  color: #e4c77a;
  font-size: 72rpx;
  font-weight: 900;
  text-align: center;
}

.score-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.score-meta > view {
  flex: 1 1 calc((100% - 14rpx) / 2);
  min-width: 220rpx;
}

.meta-label {
  color: #9aa9c4;
  font-size: 22rpx;
}

.meta-value {
  margin-top: 4rpx;
  color: #f6f8ff;
  font-size: 28rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.undo-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, .16);
  border-radius: 999rpx;
  color: #e8eefa;
  background: rgba(255, 255, 255, .06);
  font-size: 22rpx;
  line-height: 1.2;
  text-align: center;
}

.undo-btn[disabled] {
  opacity: .42;
}

.card-title {
  color: #f6f8ff;
  font-size: 30rpx;
  font-weight: 800;
}

.card-title.no-gap {
  margin-bottom: 4rpx;
}

.situation-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: 20rpx;
}

.outs-panel,
.bases-panel {
  min-height: 246rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .1);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .04);
}

.label.compact {
  margin-bottom: 12rpx;
  color: #9aa9c4;
  font-size: 22rpx;
}

.out-dots {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 0 24rpx;
}

.out-dot {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid rgba(255, 255, 255, .22);
  border-radius: 50%;
  background: rgba(255, 255, 255, .06);
}

.out-dot.active {
  border-color: rgba(255, 138, 138, .78);
  background: #ff8a8a;
  box-shadow: 0 0 18rpx rgba(255, 138, 138, .28);
}

.compact-actions {
  gap: 10rpx;
}

.base-board {
  position: relative;
  height: 190rpx;
}

.base-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  min-width: 92rpx;
  min-height: 54rpx;
  padding: 0 12rpx;
  border: 1rpx solid rgba(143, 176, 255, .28);
  border-radius: 20rpx;
  color: #dbe5f8;
  background: rgba(143, 176, 255, .08);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.base-btn.active {
  color: #081120;
  border-color: #e4c77a;
  background: #e4c77a;
}

.base-second { left: 50%; top: 12rpx; transform: translateX(-50%); }
.base-third { left: 14rpx; top: 76rpx; }
.base-first { right: 14rpx; top: 76rpx; }

.home-plate {
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 92rpx;
  height: 42rpx;
  line-height: 42rpx;
  transform: translateX(-50%);
  border: 1rpx solid rgba(255, 255, 255, .14);
  border-radius: 10rpx;
  color: #9aa9c4;
  text-align: center;
  font-size: 20rpx;
}

.clear-bases,
.next-half {
  margin-top: 14rpx;
}

.score-actions,
.batter-nav,
.inning-nav,
.add-pitcher {
  margin-top: 18rpx;
}

.batter-picker {
  margin-top: 16rpx;
}

.adjustment-form {
  margin-top: 14rpx;
}

.wide-scroll {
  width: 100%;
  margin-top: 18rpx;
}

.line-table,
.bat-table {
  width: max-content;
  min-width: 100%;
}

.line-row {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.line-row.header,
.bat-row.header {
  color: #9aa9c4;
}

.team {
  width: 188rpx;
  color: #f6f8ff;
  font-size: 24rpx;
}

.cell {
  width: 58rpx;
  text-align: center;
  color: #dbe5f8;
  font-weight: 700;
}

.cell.total {
  color: #e4c77a;
  font-weight: 900;
}

.stat-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.stat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 calc((100% - 12rpx) / 2);
  min-width: 180rpx;
  min-height: 74rpx;
  padding: 0 10rpx;
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 22rpx;
  color: #e8eefa;
  background: rgba(255, 255, 255, .06);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.stat-btn.gold {
  color: #081120;
  background: #e4c77a;
}

.stat-btn.danger {
  color: #ffdddd;
  border-color: rgba(255, 138, 138, .32);
}

.pitcher-card {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .08);
}

.pitch-name {
  color: #f6f8ff;
  font-size: 28rpx;
  font-weight: 800;
}

.pitcher-actions {
  margin-top: 16rpx;
}

.opponent-line {
  margin-top: 12rpx;
  color: #dbe5f8;
  font-size: 26rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.bat-row {
  display: grid;
  grid-template-columns: 220rpx repeat(7, 66rpx);
  align-items: center;
  min-height: 66rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
  color: #dbe5f8;
  font-size: 24rpx;
  text-align: center;
}

.bat-row.active {
  background: rgba(228, 199, 122, .12);
}

.bat-name {
  color: #f6f8ff;
  font-weight: 700;
  text-align: left;
}

.log-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 82rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
}

.log-main {
  min-width: 0;
}

.log-title {
  color: #f6f8ff;
  font-size: 26rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.log-score {
  flex: 0 0 auto;
  color: #e4c77a;
  font-size: 28rpx;
  font-weight: 900;
}

.save {
  margin-top: 24rpx;
}
